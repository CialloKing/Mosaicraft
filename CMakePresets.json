{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/third_party/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_MANIFEST_INSTALL": false,
        "MOSAICRAFT_CUDA": false,
        "MOSAICRAFT_VULKAN": false,
        "MOSAICRAFT_VULKAN_AUTO": false,
        "MOSAICRAFT_METAL": false
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-x64",
      "architecture": "ARM64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-release",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/third_party/vcpkg_installed/arm64"
      }
    },
    {
      "name": "linux-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MOSAICRAFT_LINUX_ARCH": "x64",
        "MOSAICRAFT_CUDA": false,
        "MOSAICRAFT_VULKAN": false,
        "MOSAICRAFT_VULKAN_AUTO": false,
        "MOSAICRAFT_METAL": false
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "linux-x64",
      "cacheVariables": {
        "MOSAICRAFT_LINUX_ARCH": "arm64"
      }
    },
    {
      "name": "macos-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "MOSAICRAFT_CUDA": false,
        "MOSAICRAFT_VULKAN": false,
        "MOSAICRAFT_VULKAN_AUTO": false,
        "MOSAICRAFT_METAL": false
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "macos-x64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    }
  ]
}
