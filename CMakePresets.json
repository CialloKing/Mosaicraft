{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-build",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MOSAICRAFT_VULKAN": "OFF",
        "MOSAICRAFT_METAL": "OFF"
      }
    },
    {
      "name": "windows-dependencies",
      "inherits": "release-build",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    },
    {
      "name": "windows-cpu",
      "inherits": "windows-dependencies",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "MOSAICRAFT_CUDA": "OFF"
      },
      "architecture": "x64"
    },
    {
      "name": "windows-cuda",
      "inherits": "windows-cpu",
      "cacheVariables": {
        "MOSAICRAFT_CUDA": "ON",
        "CUDAToolkit_ROOT": "$env{CUDAToolkit_ROOT}"
      }
    },
    {
      "name": "linux-cpu",
      "inherits": "release-build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "MOSAICRAFT_CUDA": "OFF"
      }
    },
    {
      "name": "linux-cuda",
      "inherits": "linux-cpu",
      "cacheVariables": {
        "MOSAICRAFT_CUDA": "ON",
        "CUDAToolkit_ROOT": "$env{CUDAToolkit_ROOT}"
      }
    },
    {
      "name": "macos-cpu",
      "inherits": "release-build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "MOSAICRAFT_CUDA": "OFF"
      }
    },
    {
      "name": "macos-arm64-cpu",
      "inherits": "macos-cpu",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "default",
      "displayName": "Windows CUDA (legacy alias)",
      "inherits": "windows-cuda",
      "binaryDir": "${sourceDir}/build/windows-cuda"
    },
    {
      "name": "relwithdebinfo",
      "inherits": "windows-cuda",
      "binaryDir": "${sourceDir}/build/windows-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-vulkan",
      "inherits": "windows-cpu",
      "cacheVariables": {
        "MOSAICRAFT_VULKAN": "ON"
      }
    },
    {
      "name": "windows-cuda-vulkan",
      "inherits": "windows-cuda",
      "cacheVariables": {
        "MOSAICRAFT_VULKAN": "ON"
      }
    },
    {
      "name": "linux-vulkan",
      "inherits": "linux-cpu",
      "cacheVariables": {
        "MOSAICRAFT_VULKAN": "ON"
      }
    },
    {
      "name": "macos-metal",
      "inherits": "macos-arm64-cpu",
      "cacheVariables": {
        "MOSAICRAFT_METAL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "configuration": "Release"
    },
    {
      "name": "windows-cuda",
      "configurePreset": "windows-cuda",
      "configuration": "Release"
    },
    {
      "name": "linux-cpu",
      "configurePreset": "linux-cpu",
      "configuration": "Release"
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda",
      "configuration": "Release"
    },
    {
      "name": "macos-cpu",
      "configurePreset": "macos-cpu",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-cpu",
      "configurePreset": "macos-arm64-cpu",
      "configuration": "Release"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-vulkan",
      "configurePreset": "windows-vulkan",
      "configuration": "Release"
    },
    {
      "name": "windows-cuda-vulkan",
      "configurePreset": "windows-cuda-vulkan",
      "configuration": "Release"
    },
    {
      "name": "linux-vulkan",
      "configurePreset": "linux-vulkan",
      "configuration": "Release"
    },
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cuda",
      "configurePreset": "windows-cuda",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cpu",
      "configurePreset": "linux-cpu",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-cpu",
      "configurePreset": "macos-cpu",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-cpu",
      "configurePreset": "macos-arm64-cpu",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vulkan",
      "configurePreset": "windows-vulkan",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cuda-vulkan",
      "configurePreset": "windows-cuda-vulkan",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-vulkan",
      "configurePreset": "linux-vulkan",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
