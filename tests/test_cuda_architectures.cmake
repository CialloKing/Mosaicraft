cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/CudaArchitectures.cmake")
set(codes sm_75 sm_80 sm_86 sm_89 sm_90 sm_120)
set(archs compute_75 compute_80 compute_86 compute_89 compute_90 compute_120)
if(DEFINED invalid)
    mosaicraft_cuda_architectures("${invalid}" "${codes}" "${archs}" targets ptx flags)
    message(FATAL_ERROR "Invalid target was accepted")
endif()
mosaicraft_cuda_architectures("sm_120;sm_89;sm_75;sm_80;sm_86;sm_90;sm_89" "${codes}" "${archs}" targets ptx flags)
if(NOT targets STREQUAL "sm_75;sm_80;sm_86;sm_89;sm_90;sm_120" OR NOT ptx STREQUAL "compute_75")
    message(FATAL_ERROR "Universal target normalization failed")
endif()
list(LENGTH flags count)
if(NOT count EQUAL 7)
    message(FATAL_ERROR "Expected six native targets and one PTX target")
endif()
mosaicraft_cuda_architectures("sm_86" "${codes}" "${archs}" targets ptx flags)
if(NOT flags STREQUAL "-gencode=arch=compute_86,code=sm_86;-gencode=arch=compute_86,code=compute_86")
    message(FATAL_ERROR "Legacy single target changed")
endif()
foreach(bad IN ITEMS "sm_999" "89" "")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-Dinvalid=${bad}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "CUDA_ARCH")
        message(FATAL_ERROR "Expected clear rejection of '${bad}': ${error}")
    endif()
endforeach()
