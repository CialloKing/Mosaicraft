cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ReleaseChecks.cmake")

set(info "Runtime: cuda\nPlatform: linux\nGpuValidation: not-run\nCudaArchitectures: ${MOSAICRAFT_NATIVE}\nCudaPtx: ${MOSAICRAFT_PTX}\nCudaToolkit: 13.5.37\nCudaRuntimeMode: shared\nGpuValidationRuntime: not-run\nGpuValidationDevice: not-run\nGpuValidationComputeCapability: not-run\nGpuValidationDriver: not-run\n")
if(DEFINED INVALID)
    if(INVALID STREQUAL "targets")
        string(REPLACE "CudaPtx: ${MOSAICRAFT_PTX}" "CudaPtx: compute_120" info "${info}")
    elseif(INVALID STREQUAL "runtime")
        string(REPLACE "CudaRuntimeMode: shared" "CudaRuntimeMode: hybrid" info "${info}")
    elseif(INVALID STREQUAL "device")
        string(REPLACE "GpuValidationDevice: not-run" "GpuValidationDevice: claimed device" info "${info}")
    elseif(INVALID STREQUAL "partial")
        string(REPLACE "CudaToolkit: 13.5.37\n" "" info "${info}")
    elseif(INVALID STREQUAL "duplicate")
        string(APPEND info "GpuValidation: passed\n")
    endif()
    release_cuda_metadata("${info}")
    return()
endif()
release_cuda_metadata("Runtime: cuda\n")
release_cuda_metadata("${info}")
foreach(case IN ITEMS targets runtime device partial duplicate)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINVALID=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "CUDA|unvalidated|Duplicate metadata")
        message(FATAL_ERROR "Incorrect result for invalid metadata (${case}): ${status}\n${error}")
    endif()
endforeach()
