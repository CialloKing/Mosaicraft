  <property name="styleSheet"><string notr="true"><![CDATA[
QDialog { background: #2c2c2c; }
QWidget { color: #e3e3e3; font-size: 13px; }
QLabel[muted="true"] { color: #b0b0b0; }
QLabel[sectionTitle="true"] { color: #eeeeee; font-size: 20px; font-weight: bold; }
QListWidget, QLineEdit, QComboBox, QSpinBox { background: #242424; border: 1px solid #515151; border-radius: 4px; }
QListWidget { outline: 0; }
QListWidget::item { padding: 10px; }
QListWidget::item:selected { background: #515151; color: #f4f4f4; }
QComboBox, QLineEdit, QSpinBox { padding: 6px; }
QComboBox QAbstractItemView { background: #303030; selection-background-color: #606060; }
QPushButton { background: #383838; border: 1px solid #535353; border-radius: 4px; padding: 6px 12px; }
QPushButton:hover { background: #484848; }
QPushButton:default { background: #575757; border-color: #727272; }
  ]]></string></property>
