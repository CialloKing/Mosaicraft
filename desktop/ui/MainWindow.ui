<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1440</width><height>900</height></rect></property>
  <property name="minimumSize"><size><width>1080</width><height>690</height></size></property>
  <property name="windowTitle"><string notr="true">Mosaicraft</string></property>
  <property name="styleSheet"><string notr="true"><![CDATA[
QMainWindow, QWidget#workspaceRoot, QStackedWidget#workspaces { background: #242424; }
QWidget { color: #e3e3e3; font-size: 13px; }
QMenuBar, QMenu, QStatusBar { background: #282828; color: #e3e3e3; }
QMenuBar { padding: 3px 9px; border-bottom: 1px solid #424242; }
QMenuBar::item { padding: 5px 11px; }
QMenu { border: 1px solid #545454; padding: 4px; }
QMenu::item { padding: 6px 30px 6px 16px; }
QMenu::item:disabled { color: #818181; }
QMenuBar::item:selected, QMenu::item:selected { background: #464646; }
QMenu::separator { height: 1px; background: #444444; margin: 3px 7px; }
QFrame#workspaceBar, QFrame#libraryToolbar, QFrame#canvasFooter { background: #2c2c2c; border: 1px solid #424242; }
QFrame#editorCanvasPanel, QFrame#exportPreviewPanel, QFrame#exportDetailsPanel {
 background: #2c2c2c; border: 1px solid #444444; border-radius: 3px;
}
QFrame#modeRail { background: #303030; border: 1px solid #464646; border-radius: 3px; }
QWidget#canvasEmpty, QGraphicsView { background: #171717; border: none; }
QLabel#brandMark { background: #494949; color: #f4f4f4; border: 1px solid #626262; border-radius: 3px; font-size: 17px; font-weight: bold; }
QLabel#brandName { font-size: 18px; font-weight: bold; letter-spacing: 0.5px; }
QLabel[sectionTitle="true"] { color: #eeeeee; font-size: 15px; font-weight: bold; }
QLabel[muted="true"] { color: #b0b0b0; }
QLabel[badge="true"] { color: #dedede; background: #3b3b3b; border: 1px solid #555555; border-radius: 2px; padding: 3px 8px; }
QToolButton[workspaceButton="true"] { min-width: 72px; min-height: 30px; border: 1px solid transparent; }
QToolButton[workspaceButton="true"]:checked { background: #474747; color: #f5f5f5; border-color: #696969; }
QToolButton[railButton="true"] { min-width: 48px; min-height: 36px; padding: 3px; }
QPushButton, QToolButton { background: #383838; border: 1px solid #535353; border-radius: 3px; padding: 5px 10px; }
QPushButton:hover, QToolButton:hover { background: #484848; border-color: #737373; }
QPushButton:focus, QToolButton:focus { border-color: #919191; }
QPushButton:disabled, QToolButton:disabled { color: #818181; background: #303030; border-color: #424242; }
QPushButton[primary="true"] { color: #f6f6f6; background: #575757; border-color: #727272; font-weight: bold; }
QPushButton[primary="true"]:hover { background: #666666; }
QPushButton[primary="true"]:disabled { background: #404040; color: #929292; border-color: #4b4b4b; }
QToolButton:checked { background: #4e4e4e; color: #f6f6f6; border-color: #777777; }
QToolButton:checked:disabled { background: #353535; color: #818181; border-color: #474747; }
QToolButton#newTabButton { padding: 3px; min-width: 24px; max-width: 28px; }
QWidget#captionControls QToolButton { font: 10px "Segoe MDL2 Assets"; background: transparent; border: 0; border-radius: 0; padding: 0; }
QWidget#captionControls QToolButton:hover { background: #464646; }
QWidget#captionControls QToolButton#captionClose:hover { background: #c42b1c; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
 padding: 5px 7px; background: #242424; border: 1px solid #515151; border-radius: 3px; selection-background-color: #606060;
}
QSpinBox QLineEdit, QDoubleSpinBox QLineEdit { background: transparent; border: 0; margin: 0; padding: 0; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #9b9b9b; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color: #848484; background: #303030; }
QLabel:disabled, QLabel[muted="true"]:disabled, QCheckBox:disabled { color: #858585; }
QComboBox QAbstractItemView { background: #303030; border: 1px solid #515151; selection-background-color: #5b5b5b; }
QGroupBox { background: #323232; border: 1px solid #454545; border-radius: 3px; margin-top: 13px; padding: 9px 8px 7px; }
QGroupBox::title { subcontrol-origin: margin; left: 9px; padding: 0 5px; color: #d6d6d6; font-weight: bold; }
QTabWidget::pane { border: 1px solid #474747; background: #303030; }
QTabBar::tab { background: #303030; color: #bfbfbf; padding: 7px 13px; border: 1px solid #474747; }
QTabBar::tab:selected { background: #444444; color: #f3f3f3; border-bottom: 2px solid #a0a0a0; }
QTabBar::tab:hover:!selected { background: #3b3b3b; }
QTabBar::tab:disabled { color: #878787; border-bottom-color: #474747; }
QListWidget { background: #252525; border: 1px solid #484848; border-radius: 3px; outline: 0; }
QListWidget::item { padding: 5px; }
QListWidget::item:selected { background: #515151; color: #f4f4f4; }
QListWidget::item:hover:!selected { background: #373737; }
QScrollArea { border: 0; }
QScrollBar:vertical { width: 11px; background: #2d2d2d; }
QScrollBar::handle:vertical { min-height: 28px; background: #626262; border-radius: 4px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: #7c7c7c; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QWidget#parameterTab, QWidget#parameterContent, QScrollArea#parameterScroll { background: #3b3b3b; }
QFrame#previewActions { background: #353535; border-bottom: 1px solid #6f6f6f; }
QFrame#basicSettingsSeparator, QFrame#matchingSettingsSeparator { background: #6f6f6f; border: 0; }
QLabel[parameterHeading="true"] { color: #e2e2e2; font-weight: bold; }
QLabel[parameterHeading="true"]:disabled { color: #959595; }
QLabel[parameterLabel="true"] { min-width: 74px; }
QWidget#parameterContent QLineEdit, QWidget#parameterContent QComboBox,
QWidget#parameterContent QSpinBox, QWidget#parameterContent QDoubleSpinBox { padding: 3px 6px; border-radius: 2px; }
QWidget#parameterContent QSpinBox QLineEdit, QWidget#parameterContent QDoubleSpinBox QLineEdit { border: 0; padding: 0; }
QLineEdit[dimensionField="true"] { min-width: 48px; min-height: 17px; }
QToolButton[ratioButton="true"] { min-width: 32px; min-height: 17px; padding: 3px 4px; border-radius: 2px; }
QWidget#exportControls { background: #292929; }
QSplitter::handle { background: #242424; }
QSplitter::handle:hover { background: #727272; }
QPlainTextEdit { background: #232323; border: 1px solid #494949; color: #b0b0b0; }
QComboBox#zoomPicker { padding: 1px 4px; border-radius: 0; }
QComboBox#zoomPicker QLineEdit { border: 0; padding: 1px 3px; background: transparent; }
QSplitter#compareSplitter::handle { background: #515151; }
QSplitter#compareSplitter::handle:hover { background: #909090; }
QLabel#canvasInfo { padding: 1px 8px; }
QListWidget#candidateList::item:selected { border: 2px solid #d8d8d8; background: #515151; }
QProgressBar { min-height: 5px; max-height: 5px; border: 0; background: #414141; }
QProgressBar::chunk { background: #a0a0a0; }
  ]]></string></property>
