cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")

# An Actions artifact contains one archive and the matching detached checksum.
if(DEFINED ARCHIVE_DIR)
    if(DEFINED ARCHIVE OR DEFINED TAG OR DEFINED EXPECTED_SHA256)
        message(FATAL_ERROR "ARCHIVE_DIR is an alternative to TAG and ARCHIVE/EXPECTED_SHA256")
    endif()
    file(GLOB archives LIST_DIRECTORIES FALSE "${ARCHIVE_DIR}/*.zip" "${ARCHIVE_DIR}/*.tar.gz")
    list(LENGTH archives count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one release archive in ${ARCHIVE_DIR}")
    endif()
    list(GET archives 0 ARCHIVE)
    release_file("${ARCHIVE}.sha256")
    get_filename_component(name "${ARCHIVE}" NAME)
    file(READ "${ARCHIVE}.sha256" checksum)
    string(STRIP "${checksum}" checksum)
    if(NOT checksum MATCHES "^([a-fA-F0-9]+)  (.+)$" OR NOT CMAKE_MATCH_2 STREQUAL name)
        message(FATAL_ERROR "Invalid archive checksum sidecar: ${ARCHIVE}.sha256")
    endif()
    set(EXPECTED_SHA256 "${CMAKE_MATCH_1}")
endif()

# Local checks never contact GitHub. Online mode derives provenance from the actual tag and asset.
if(DEFINED TAG)
    if(DEFINED ARCHIVE OR NOT TAG MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "Provide a stable TAG and ASSET, or a local ARCHIVE")
    endif()
    if(NOT DEFINED ASSET)
        release_host(host arch suffix)
        if(NOT EXPECTED_RUNTIME MATCHES "^(cpu-only|cuda|vulkan)$")
            message(FATAL_ERROR "Automatic published attachment selection requires EXPECTED_RUNTIME")
        endif()
        string(SUBSTRING "${TAG}" 1 -1 published_version)
        if((host STREQUAL "linux" AND EXPECTED_RUNTIME STREQUAL "cuda" AND published_version VERSION_LESS 1.14.8) OR
           (EXPECTED_RUNTIME STREQUAL "vulkan" AND published_version VERSION_LESS 1.15.9))
            message(STATUS "${TAG} did not publish ${host} ${EXPECTED_RUNTIME}")
            return()
        endif()
        set(extension tar.gz)
        if(host STREQUAL "windows")
            set(extension zip)
        endif()
        set(ASSET "Mosaicraft_${TAG}_${host}-${arch}_${EXPECTED_RUNTIME}.${extension}")
    endif()
    if(NOT DEFINED REPOSITORY)
        set(REPOSITORY CialloKing/Mosaicraft)
    endif()
    if(NOT REPOSITORY MATCHES "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$" OR
       NOT ASSET MATCHES "^Mosaicraft_${TAG}_[a-zA-Z0-9_-]+\\.(zip|tar\\.gz)$")
        message(FATAL_ERROR "Invalid repository or attachment name")
    endif()
    find_program(gh gh REQUIRED)
    release_capture(ref "${gh}" api "repos/${REPOSITORY}/git/ref/tags/${TAG}")
    string(JSON commit GET "${ref}" object sha)
    string(JSON type GET "${ref}" object type)
    if(type STREQUAL "tag")
        release_capture(ref "${gh}" api "repos/${REPOSITORY}/git/tags/${commit}")
        string(JSON commit GET "${ref}" object sha)
        string(JSON type GET "${ref}" object type)
    endif()
    if(NOT type STREQUAL "commit" OR (DEFINED EXPECTED_COMMIT AND NOT EXPECTED_COMMIT STREQUAL commit))
        message(FATAL_ERROR "GitHub tag does not point to the expected commit")
    endif()
    set(EXPECTED_COMMIT "${commit}")
    release_capture(release "${gh}" api "repos/${REPOSITORY}/releases/tags/${TAG}")
    string(JSON assets LENGTH "${release}" assets)
    math(EXPR last "${assets} - 1")
    set(archive_count 0)
    if(last GREATER_EQUAL 0)
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${release}" assets ${index} name)
            if(name MATCHES "\\.(zip|tar\\.gz)$")
                math(EXPR archive_count "${archive_count} + 1")
            endif()
            if(name STREQUAL ASSET)
                string(JSON asset_id GET "${release}" assets ${index} id)
                string(JSON digest ERROR_VARIABLE digest_error GET "${release}" assets ${index} digest)
                if(digest_error OR NOT digest MATCHES "^sha256:([a-fA-F0-9]+)$")
                    unset(digest)
                else()
                    set(digest "${CMAKE_MATCH_1}")
                endif()
            endif()
        endforeach()
    endif()
    if(NOT DEFINED asset_id)
        message(FATAL_ERROR "Attachment not found: ${ASSET}")
    endif()
    string(JSON body GET "${release}" body)
    string(REPLACE "\n" ";" body_lines "${body}")
    foreach(line IN LISTS body_lines)
        string(FIND "${line}" "${ASSET}" position)
        if(position GREATER_EQUAL 0)
            string(REGEX MATCHALL "[a-fA-F0-9]+" tokens "${line}")
            foreach(token IN LISTS tokens)
                string(LENGTH "${token}" size)
                if(size EQUAL 64)
                    set(body_sha "${token}")
                endif()
            endforeach()
        endif()
    endforeach()
    if(NOT DEFINED body_sha AND archive_count EQUAL 1)
        string(REGEX MATCHALL "SHA256:[ \t]*`?[a-fA-F0-9]+" matches "${body}")
        if(matches)
            list(GET matches -1 body_sha)
            string(REGEX REPLACE "^SHA256:[ \t]*`?" "" body_sha "${body_sha}")
        endif()
    endif()
    if(NOT DEFINED digest AND NOT DEFINED body_sha AND NOT DEFINED EXPECTED_SHA256)
        message(FATAL_ERROR "Release has no verifiable SHA-256: ${ASSET}")
    endif()
elseif(NOT DEFINED ARCHIVE OR NOT DEFINED EXPECTED_SHA256 OR NOT DEFINED EXPECTED_COMMIT)
    message(FATAL_ERROR "Local verification requires ARCHIVE, EXPECTED_SHA256 and EXPECTED_COMMIT")
endif()

release_file("${CHECK_TOOL}")
release_host(host arch executable_suffix)
if(NOT DEFINED WORK_ROOT)
    if(CMAKE_HOST_WIN32)
        set(WORK_ROOT "$ENV{TEMP}")
    elseif(NOT "$ENV{TMPDIR}" STREQUAL "")
        set(WORK_ROOT "$ENV{TMPDIR}")
    else()
        set(WORK_ROOT /tmp)
    endif()
endif()
file(REAL_PATH "${CHECK_TOOL}" CHECK_TOOL)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/mosaicraft 验收-${nonce}")
set(root "${work}/Mosaicraft archive")
file(MAKE_DIRECTORY "${root}")
message(STATUS "Verification workspace: ${work}")
if(DEFINED TAG)
    set(ARCHIVE "${work}/${ASSET}")
    execute_process(COMMAND "${gh}" api -H "Accept: application/octet-stream"
        "repos/${REPOSITORY}/releases/assets/${asset_id}" OUTPUT_FILE "${ARCHIVE}" COMMAND_ERROR_IS_FATAL ANY)
endif()
release_file("${ARCHIVE}")
file(SHA256 "${ARCHIVE}" sha)
foreach(key IN ITEMS EXPECTED_SHA256 digest body_sha)
    if(DEFINED ${key})
        string(TOLOWER "${${key}}" expected)
        if(NOT expected STREQUAL sha)
            message(FATAL_ERROR "SHA-256 mismatch (${key}) for ${ARCHIVE}")
        endif()
    endif()
endforeach()
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${root}")
get_filename_component(name "${ARCHIVE}" NAME)
if(DEFINED EXPECTED_CHANNEL AND NOT EXPECTED_CHANNEL MATCHES "^(stable|candidate)$")
    message(FATAL_ERROR "EXPECTED_CHANNEL must be stable or candidate")
endif()
foreach(path IN ITEMS index.html BUILD_INFO.txt README.md LICENSE third_party_versions.txt
        "mosaicraft${executable_suffix}" "MosaicraftWebUI${executable_suffix}")
    release_file("${root}/${path}")
endforeach()
if(EXISTS "${root}/docs/README.md")
    foreach(path IN ITEMS releases.md guides/quick-start.md reference/api.md development/portable-gpu.md
            archive/README.md performance/portable-gpu-20261113.json)
        release_file("${root}/docs/${path}")
    endforeach()
else()
    release_file("${root}/API.md")
    release_file("${root}/ENCYCLOPEDIA.md")
endif()
file(GLOB_RECURSE forbidden RELATIVE "${root}" LIST_DIRECTORIES FALSE "${root}/*")
list(FILTER forbidden INCLUDE REGEX "(^|/)(CHANGELOG\\.md|RELEASE_NOTES_[^/]*\\.md)$")
if(forbidden)
    message(FATAL_ERROR "Obsolete documentation in archive: ${forbidden}")
endif()
file(READ "${root}/BUILD_INFO.txt" info)
foreach(key IN ITEMS Name Version Package Platform Arch Runtime Commit Configuration GpuValidation VulkanBackend MetalBackend
        PortableGpuValidation PortableAutoSelection PortableKernelVersion ScoreModes
        QualityDegradationLimit FinalSelectionDifferenceLimit)
    release_field("${info}" "${key}" ${key})
endforeach()
set(legacy OFF)
set(contracts_file "${root}/contracts.json")
if(EXISTS "${contracts_file}")
    file(READ "${contracts_file}" contracts)
    string(JSON version GET "${contracts}" softwareVersion)
elseif(NOT REQUIRE_CURRENT AND Version MATCHES "^1[.]14[.][0-9]+$" AND NOT Version VERSION_LESS 1.14.7)
    # The older tagged builds predate contracts.json and the modern CLI layout.
    set(version "${Version}")
    set(legacy ON)
else()
    release_file("${contracts_file}")
endif()
if(DEFINED TAG AND NOT TAG STREQUAL "v${version}")
    message(FATAL_ERROR "Archive version does not match ${TAG}")
endif()
if(NOT Name STREQUAL "Mosaicraft" OR NOT Configuration STREQUAL "Release" OR NOT Version STREQUAL version OR
   NOT Package STREQUAL name OR NOT Platform STREQUAL host OR NOT Arch STREQUAL arch)
    message(FATAL_ERROR "Archive metadata does not match version, asset name or native host")
endif()
if(DEFINED EXPECTED_CHANNEL)
    set(extension tar.gz)
    if(host STREQUAL "windows")
        set(extension zip)
    endif()
    set(suffix "")
    if(EXPECTED_CHANNEL STREQUAL "candidate")
        set(suffix _candidate)
    endif()
    if(NOT name STREQUAL "Mosaicraft_v${version}_${host}-${arch}_${Runtime}${suffix}.${extension}")
        message(FATAL_ERROR "Archive name does not match the target, runtime and channel: ${name}")
    endif()
endif()
string(TOLOWER "${EXPECTED_COMMIT}" expected_commit)
string(TOLOWER "${Commit}" commit)
string(LENGTH "${commit}" length)
if(NOT length EQUAL 40 OR NOT commit MATCHES "^[a-f0-9]+$" OR NOT commit STREQUAL expected_commit)
    message(FATAL_ERROR "Incorrect archive commit: ${Commit}")
endif()
if(NOT Runtime MATCHES "^(cpu-only|cuda|vulkan|cuda-vulkan|metal)$" OR
   (DEFINED EXPECTED_RUNTIME AND NOT Runtime STREQUAL EXPECTED_RUNTIME) OR
   (DEFINED EXPECTED_GPU_VALIDATION AND NOT GpuValidation STREQUAL EXPECTED_GPU_VALIDATION) OR
   (NOT GpuValidation STREQUAL "" AND NOT GpuValidation MATCHES "^(not-run|passed|not-applicable)$") OR
   (Runtime STREQUAL "cpu-only" AND NOT GpuValidation STREQUAL "" AND NOT GpuValidation STREQUAL "not-applicable"))
    message(FATAL_ERROR "Unexpected runtime or GPU acceptance state")
endif()
if(NOT legacy)
    string(JSON fields LENGTH "${contracts}")
    math(EXPR last "${fields} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON key MEMBER "${contracts}" ${index})
        string(JSON expected GET "${contracts}" "${key}")
        release_field("${info}" "Internal.${key}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Internal version mismatch: ${key}")
        endif()
    endforeach()
endif()
release_cuda_metadata("${info}")
if(Runtime STREQUAL "cuda" AND GpuValidation STREQUAL "not-run" AND
   NOT name MATCHES "_candidate\\.(zip|tar\\.gz)$" AND NOT name STREQUAL "Mosaicraft_v${version}_linux-x64_cuda.tar.gz")
    message(FATAL_ERROR "Unvalidated CUDA package has a stable non-Linux filename")
endif()
set(smoke_args)
if(REQUIRE_CURRENT)
    list(APPEND smoke_args --current)
    set(vulkan_status disabled)
    set(metal_status disabled)
    if(Runtime MATCHES "vulkan")
        set(vulkan_status enabled)
    elseif(Runtime STREQUAL "metal")
        set(metal_status enabled)
    endif()
    if(NOT VulkanBackend STREQUAL vulkan_status OR NOT MetalBackend STREQUAL metal_status OR GpuValidation STREQUAL "")
        message(FATAL_ERROR "Missing or inconsistent current backend metadata")
    endif()
    if(Runtime MATCHES "^cuda")
        foreach(field IN ITEMS CudaArchitectures CudaPtx CudaToolkit CudaRuntimeMode)
            release_field("${info}" "${field}" value)
            if(value STREQUAL "")
                message(FATAL_ERROR "Missing current CUDA metadata: ${field}")
            endif()
        endforeach()
    endif()
endif()
if(Runtime MATCHES "^(vulkan|cuda-vulkan|metal)$")
    if(EXISTS "${root}/docs/README.md")
        release_file("${root}/docs/development/portable-gpu.md")
    else()
        release_file("${root}/docs/PORTABLE_GPU.md")
    endif()
    release_file("${root}/docs/performance/portable-gpu-20261113.json")
    if(NOT PortableGpuValidation STREQUAL "not-run" OR NOT PortableKernelVersion STREQUAL "portable-v1" OR
       NOT ScoreModes STREQUAL "compatible;fast" OR NOT QualityDegradationLimit STREQUAL "0.01" OR
       NOT FinalSelectionDifferenceLimit STREQUAL "0.01" OR
       (Runtime MATCHES "vulkan" AND NOT VulkanBackend STREQUAL "enabled") OR
       (Runtime STREQUAL "metal" AND NOT MetalBackend STREQUAL "enabled"))
        message(FATAL_ERROR "Unexpected portable GPU acceptance state")
    endif()
    if(Runtime STREQUAL "vulkan" AND name MATCHES "_vulkan\\.(zip|tar\\.gz)$")
        if(NOT PortableAutoSelection STREQUAL "vulkan-to-cpu" OR NOT VulkanBackend STREQUAL "enabled" OR
           NOT MetalBackend STREQUAL "disabled" OR NOT GpuValidation STREQUAL "not-run")
            message(FATAL_ERROR "Incorrect stable Vulkan metadata")
        endif()
        # Hide drivers only from this verifier and its subprocesses, never from the host.
        set(ENV{VK_DRIVER_FILES} "${work}/no-icd.json")
        set(ENV{VK_ICD_FILENAMES} "${work}/no-icd.json")
        list(APPEND smoke_args --vulkan-fallback)
    elseif(NOT PortableAutoSelection STREQUAL "disabled" OR NOT name MATCHES "_candidate\\.(zip|tar\\.gz)$")
        message(FATAL_ERROR "Incorrect portable GPU candidate metadata")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VerifyRuntime.cmake")
if(REQUIRE_CURRENT)
    execute_process(COMMAND "${CHECK_TOOL}" --docs "${root}" COMMAND_ERROR_IS_FATAL ANY)
endif()
verify_runtime("${root}" "${host}" "${executable_suffix}")
set(cli "${root}/mosaicraft${executable_suffix}")
set(webui "${root}/MosaicraftWebUI${executable_suffix}")
release_capture(actual "${cli}" --version)
if(NOT actual STREQUAL "Mosaicraft ${version}")
    message(FATAL_ERROR "Unexpected CLI version: ${actual}")
endif()
release_capture(help "${cli}" --help)
release_capture(web_help "${webui}" --help)
if(NOT web_help MATCHES "Usage: MosaicraftWebUI")
    message(FATAL_ERROR "Invalid Web UI executable help")
endif()
if(legacy)
    if(NOT help MATCHES "mosaicraft build" OR NOT help MATCHES "mosaicraft mosaic")
        message(FATAL_ERROR "Invalid historical CLI help")
    endif()
    set(contracts_file --legacy)
elseif(NOT help MATCHES "create <target>" OR NOT help MATCHES "render <project>" OR NOT help MATCHES "library build")
    message(FATAL_ERROR "Invalid CLI executable help")
endif()
execute_process(COMMAND "${CHECK_TOOL}" "${webui}" "${contracts_file}" ${smoke_args}
    WORKING_DIRECTORY "${root}" TIMEOUT 240 COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Verified ${name} from ${commit}, SHA256 ${sha}")
if(NOT KEEP_WORKSPACE)
    file(REMOVE_RECURSE "${work}")
endif()
