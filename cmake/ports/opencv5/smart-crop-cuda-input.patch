+Mat Net::Impl::forwardMosaicraftCudaInput(Size size, Net::MosaicraftCudaInputWriter writer,
+                                         void* userData, const String& outputName)
+{
+    CV_Assert(mainGraph && mainGraph->inputs().size() == 1 && writer && !mosaicraftInputWriter &&
+              preferableBackend == DNN_BACKEND_CUDA && preferableTarget == DNN_TARGET_CUDA &&
+              size.width > 0 && size.height > 0);
+    const Arg input = mainGraph->inputs().front();
+    const MatShape shape({1, 3, size.height, size.width});
+    CV_Assert(args.at(input.idx).type == CV_32F &&
+              (pinnedInputShapes.empty() || pinnedInputShapes.front().empty() || pinnedInputShapes.front() == shape));
+    // The host header carries the input shape. Its contents are filled only if a CPU node needs them.
+    argTensor(input).fit(shape, CV_32F);
+    struct ResetWriter
+    {
+        Net::Impl& impl;
+        ~ResetWriter()
+        {
+            impl.mosaicraftInputWriter = nullptr;
+            impl.mosaicraftInputData = nullptr;
+        }
+    } reset{*this};
+    mosaicraftInputWriter = writer;
+    mosaicraftInputData = userData;
+    try
+    {
+        return forward(outputName);
+    }
+    catch (...)
+    {
+        // On failure, the caller may free the staging buffer as soon as this method returns.
+        if (cudaInfo)
+        {
+            cudaStreamSynchronize(cudaInfo->context.stream.get());
+        }
+        throw;
+    }
+}
