{
  "name": "opencv5",
  "version": "5.1.0",
  "description": "Mosaicraft's minimal CPU build of OpenCV",
  "homepage": "https://opencv.org/",
  "license": "Apache-2.0",
  "dependencies": [
    { "name": "vcpkg-cmake", "host": true },
