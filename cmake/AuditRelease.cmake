cmake_minimum_required(VERSION 3.21)

# Trace the actual child processes, not just the top-level CMake command.
if(NOT DEFINED LOG OR LOG STREQUAL "")
    message(FATAL_ERROR "Usage: cmake -DLOG=<trace> -P AuditRelease.cmake -- <command> [args...]")
endif()
set(command)
set(after_separator FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE 1 ${last})
    set(arg "${CMAKE_ARGV${index}}")
    if(after_separator)
        string(REPLACE ";" "\;" arg "${arg}")
        list(APPEND command "${arg}")
    elseif(arg STREQUAL "--")
        set(after_separator TRUE)
    endif()
endforeach()
if(NOT command)
    message(FATAL_ERROR "Pass the audited command after --")
endif()
find_program(strace strace REQUIRED)
cmake_path(ABSOLUTE_PATH LOG NORMALIZE)
get_filename_component(dir "${LOG}" DIRECTORY)
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${strace}" -qq -f -s 4096 -e trace=execve,execveat -o "${LOG}" -- ${command}
    COMMAND_ERROR_IS_FATAL ANY)
file(SIZE "${LOG}" size)
if(size EQUAL 0)
    message(FATAL_ERROR "Empty process trace: ${LOG}")
endif()
# Restrict the pattern to the executable argument, not arbitrary command arguments.
file(STRINGS "${LOG}" traced REGEX "execve(at)?\\(")
set(pattern [=[execve(at)?\([^"]*"([^"]*/)?(python[0-9.]*|py|pypy[0-9.]*|pwsh|powershell)(\.exe)?"[ ,]|execve(at)?\([^"]*"[^"]+\.(py|ps1)"[ ,]]=])
foreach(line IN LISTS traced)
    string(TOLOWER "${line}" executable)
    if(executable MATCHES "${pattern}")
        message(FATAL_ERROR "Unexpected interpreter in ${LOG}: ${line}")
    endif()
endforeach()
