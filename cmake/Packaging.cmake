# Native installs use the system libraries. Release archives carry their own copies.
set(_bundle_default OFF)
if(WIN32 OR (VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET))
    set(_bundle_default ON)
endif()
option(MOSAICRAFT_BUNDLE_RUNTIME "Bundle runtime libraries into the install tree" ${_bundle_default})
if(MOSAICRAFT_BUNDLE_RUNTIME AND (MOSAICRAFT_SMART_CROP_CUDA OR OpenCV_USE_CUDNN))
    if(NOT MOSAICRAFT_SMART_CROP_CUDA OR NOT WIN32 OR NOT IS_ABSOLUTE "${MOSAICRAFT_SMART_CROP_CUDA_REDIST}")
        message(FATAL_ERROR "CUDA smart crop runtime bundling requires the approved Windows redist tree; local SDK installs use MOSAICRAFT_BUNDLE_RUNTIME=OFF")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
    smart_crop_cuda_redist("${CMAKE_SOURCE_DIR}" "${MOSAICRAFT_SMART_CROP_CUDA_REDIST}" cuda_dlls cuda_notices)
    list(APPEND _runtime_dirs "${MOSAICRAFT_SMART_CROP_CUDA_REDIST}")
endif()
option(MOSAICRAFT_DESKTOP_BACKEND_INSTALL "Install the CLI and desktop matcher instead of the Web UI" OFF)
if(MOSAICRAFT_DESKTOP_BACKEND_INSTALL)
    set(_runtime_targets mosaicraft mosaicraft_desktop_worker)
else()
    set(_runtime_targets mosaicraft MosaicraftWebUI)
    install(FILES "${CMAKE_BINARY_DIR}/generated/index.html" DESTINATION .)
endif()
if(MOSAICRAFT_BUNDLE_RUNTIME)
    if(APPLE)
        set(_package_rpath "@loader_path/lib")
    elseif(UNIX)
        set(_package_rpath "$ORIGIN/lib")
    endif()
    set_target_properties(${_runtime_targets} PROPERTIES INSTALL_RPATH "${_package_rpath}")
else()
    set_target_properties(${_runtime_targets} PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)
endif()
install(TARGETS ${_runtime_targets} RUNTIME DESTINATION .)
install(FILES "${CMAKE_SOURCE_DIR}/contracts.json" DESTINATION .)
install(FILES "${CMAKE_SOURCE_DIR}/third_party/miniz/LICENSE" "${CMAKE_SOURCE_DIR}/third_party/miniz/SOURCE.md"
        DESTINATION licenses/miniz)
install(FILES "${CMAKE_SOURCE_DIR}/third_party/picosha2/LICENSE" "${CMAKE_SOURCE_DIR}/third_party/picosha2/SOURCE.md"
        DESTINATION licenses/picosha2)
if(MOSAICRAFT_SMART_CROP)
    set(MOSAICRAFT_SMART_CROP_MODELS_DIR "" CACHE PATH "Prepared Mosaicraft offline models to install")
    if(MOSAICRAFT_SMART_CROP_MODELS_DIR)
        include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
        file(READ "${_smart_crop_lock}" smart_crop_lock)
        smart_crop_verified_models("${smart_crop_lock}" "${MOSAICRAFT_SMART_CROP_MODELS_DIR}" smart_crop_files)
        install(FILES ${smart_crop_files} "${_smart_crop_lock}" DESTINATION models)
        install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/third_party/model-notices/" DESTINATION licenses/models)
    else()
        install(CODE [[message(FATAL_ERROR "Set MOSAICRAFT_SMART_CROP_MODELS_DIR to the verified model directory before installing")]])
    endif()
endif()
if(NOT MOSAICRAFT_BUNDLE_RUNTIME)
    return()
endif()

# Ship the license texts associated with the locked dependency graph.
if(VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
    set(_vcpkg_prefix "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
    list(APPEND _runtime_dirs "${_vcpkg_prefix}/bin" "${_vcpkg_prefix}/lib")
    file(GLOB _dependency_licenses "${_vcpkg_prefix}/share/*/copyright")
    foreach(_license IN LISTS _dependency_licenses)
        get_filename_component(_port_dir "${_license}" DIRECTORY)
        get_filename_component(_port "${_port_dir}" NAME)
        install(FILES "${_license}" DESTINATION "licenses/${_port}")
    endforeach()
endif()
if(MOSAICRAFT_CUDA AND EXISTS "${CUDAToolkit_ROOT}/licenses")
    install(DIRECTORY "${CUDAToolkit_ROOT}/licenses/" DESTINATION licenses/cuda)
elseif(MOSAICRAFT_CUDA)
    # A full local SDK has aggregate licenses; the minimal redist installer
    # preserves per-component texts in licenses/ instead.
    foreach(_license IN ITEMS EULA.txt LICENSE)
        if(EXISTS "${CUDAToolkit_ROOT}/${_license}")
            install(FILES "${CUDAToolkit_ROOT}/${_license}" DESTINATION licenses/cuda)
        endif()
    endforeach()
endif()

if(WIN32)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
    include(InstallRequiredSystemLibraries)
    get_filename_component(_linker_dir "${CMAKE_LINKER}" DIRECTORY)
    set(_runtime_scanner "${_linker_dir}/dumpbin.exe")
endif()
if(MOSAICRAFT_CUDA)
    list(APPEND _runtime_dirs "${CUDAToolkit_LIBRARY_DIR}")
    if(WIN32)
        list(APPEND _runtime_dirs "${CUDAToolkit_BIN_DIR}" "${CUDAToolkit_BIN_DIR}/x64")
    endif()
endif()
# Discover and relocate dependencies for the same executables we actually install.
foreach(_target IN LISTS _runtime_targets)
    list(APPEND _build_executables "$<TARGET_FILE:${_target}>")
    list(APPEND _install_executables "\${CMAKE_INSTALL_PREFIX}/$<TARGET_FILE_NAME:${_target}>")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/DeployRuntime.cmake.in"
    "${CMAKE_BINARY_DIR}/DeployRuntime.in.cmake" @ONLY)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/DeployRuntime-$<CONFIG>.cmake"
    INPUT "${CMAKE_BINARY_DIR}/DeployRuntime.in.cmake")
install(SCRIPT "${CMAKE_BINARY_DIR}/DeployRuntime-$<CONFIG>.cmake")
if(MOSAICRAFT_SMART_CROP_CUDA)
    # The loader discovers some cuDNN dependencies only at inference time.
    install(FILES ${cuda_dlls} DESTINATION .)
    install(FILES ${cuda_notices} DESTINATION licenses/cuda-smart-crop)
endif()
