# Native installs use the system libraries. Release archives carry their own copies.
set(_bundle_default OFF)
if(WIN32 OR (VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET))
    set(_bundle_default ON)
endif()
option(MOSAICRAFT_BUNDLE_RUNTIME "Bundle runtime libraries into the install tree" ${_bundle_default})
if(MOSAICRAFT_BUNDLE_RUNTIME)
    if(APPLE)
        set(_package_rpath "@loader_path/lib")
    elseif(UNIX)
        set(_package_rpath "$ORIGIN/lib")
    endif()
    set_target_properties(mosaicraft MosaicraftWebUI PROPERTIES INSTALL_RPATH "${_package_rpath}")
else()
    set_target_properties(mosaicraft MosaicraftWebUI PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)
endif()
install(TARGETS mosaicraft MosaicraftWebUI RUNTIME DESTINATION .)
install(FILES "${CMAKE_BINARY_DIR}/generated/index.html" "${CMAKE_SOURCE_DIR}/contracts.json" DESTINATION .)
if(NOT MOSAICRAFT_BUNDLE_RUNTIME)
    return()
endif()

# Ship the license texts associated with the locked dependency graph.
if(VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
    set(_vcpkg_prefix "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
    list(APPEND _runtime_dirs "${_vcpkg_prefix}/bin" "${_vcpkg_prefix}/lib")
    file(GLOB _dependency_licenses "${_vcpkg_prefix}/share/*/copyright")
    foreach(_license IN LISTS _dependency_licenses)
        get_filename_component(_port_dir "${_license}" DIRECTORY)
        get_filename_component(_port "${_port_dir}" NAME)
        install(FILES "${_license}" DESTINATION "licenses/${_port}")
    endforeach()
endif()
if(MOSAICRAFT_CUDA AND EXISTS "${CUDAToolkit_ROOT}/licenses")
    install(DIRECTORY "${CUDAToolkit_ROOT}/licenses/" DESTINATION licenses/cuda)
elseif(MOSAICRAFT_CUDA)
    # A full local SDK has aggregate licenses; the minimal redist installer
    # preserves per-component texts in licenses/ instead.
    foreach(_license IN ITEMS EULA.txt LICENSE)
        if(EXISTS "${CUDAToolkit_ROOT}/${_license}")
            install(FILES "${CUDAToolkit_ROOT}/${_license}" DESTINATION licenses/cuda)
        endif()
    endforeach()
endif()

if(WIN32)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
    include(InstallRequiredSystemLibraries)
    get_filename_component(_linker_dir "${CMAKE_LINKER}" DIRECTORY)
    set(_runtime_scanner "${_linker_dir}/dumpbin.exe")
endif()
if(MOSAICRAFT_CUDA)
    list(APPEND _runtime_dirs "${CUDAToolkit_LIBRARY_DIR}")
    if(WIN32)
        list(APPEND _runtime_dirs "${CUDAToolkit_BIN_DIR}" "${CUDAToolkit_BIN_DIR}/x64")
    endif()
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/DeployRuntime.cmake.in"
    "${CMAKE_BINARY_DIR}/DeployRuntime.in.cmake" @ONLY)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/DeployRuntime-$<CONFIG>.cmake"
    INPUT "${CMAKE_BINARY_DIR}/DeployRuntime.in.cmake")
install(SCRIPT "${CMAKE_BINARY_DIR}/DeployRuntime-$<CONFIG>.cmake")
