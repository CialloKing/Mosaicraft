cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")
release_file("${ARCHIVE}")
file(REAL_PATH "${ARCHIVE}" ARCHIVE)
file(SHA256 "${ARCHIVE}" sha)
if(DEFINED EXPECTED_SHA256)
    string(TOLOWER "${EXPECTED_SHA256}" expected)
    if(NOT sha STREQUAL expected)
        message(FATAL_ERROR "Desktop archive SHA-256 mismatch")
    endif()
endif()
get_filename_component(name "${ARCHIVE}" NAME)
if(NOT name MATCHES "^(Mosaicraft_v([0-9]+\\.[0-9]+\\.[0-9]+)_(windows-x64|linux-x64|macos-arm64)_qt(_cuda-vulkan(_candidate)?)?)\\.(zip|tar\\.gz)$")
    message(FATAL_ERROR "Unexpected desktop archive name: ${name}")
endif()
set(stem "${CMAKE_MATCH_1}")
set(version "${CMAKE_MATCH_2}")
set(target "${CMAKE_MATCH_3}")
set(gpu "${CMAKE_MATCH_4}")
set(candidate "${CMAKE_MATCH_5}")
set(extension "${CMAKE_MATCH_6}")
if((target STREQUAL "windows-x64" AND NOT extension STREQUAL "zip") OR
   (NOT target STREQUAL "windows-x64" AND NOT extension STREQUAL "tar.gz") OR
   (target STREQUAL "macos-arm64" AND gpu) OR
   (candidate AND NOT target STREQUAL "windows-x64") OR (REQUIRE_GPU AND (NOT RUN_SMOKE OR NOT gpu OR candidate)))
    message(FATAL_ERROR "Unsupported desktop archive or validation mode")
endif()
if(NOT DEFINED WORK_ROOT)
    get_filename_component(WORK_ROOT "${ARCHIVE}" DIRECTORY)
endif()
cmake_path(ABSOLUTE_PATH WORK_ROOT NORMALIZE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/desktop 验收-${nonce}")
file(MAKE_DIRECTORY "${work}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${work}")
set(root "${work}/${stem}")
set(required BUILD_INFO.txt LICENSE desktop-redistribution.txt licenses/qt/LGPL-3.0-only.txt)
set(bin "${root}/bin")
set(exe "")
if(target STREQUAL "windows-x64")
    set(exe .exe)
    list(APPEND required bin/qt.conf bin/vcruntime140.dll)
elseif(target STREQUAL "linux-x64")
    list(APPEND required bin/qt.conf licenses/qt/ICU-73.2.txt)
else()
    set(app "${root}/MosaicraftDesktop.app/Contents")
    set(bin "${app}/MacOS")
    list(APPEND required MosaicraftDesktop.app/Contents/Info.plist MosaicraftDesktop.app/Contents/_CodeSignature/CodeResources)
endif()
foreach(path IN LISTS required)
    release_file("${root}/${path}")
endforeach()
foreach(program IN ITEMS MosaicraftDesktop mosaicraft mosaicraft_desktop_worker)
    release_file("${bin}/${program}${exe}")
endforeach()
release_file("${bin}/contracts.json")
# Inspect archive entries rather than extracted symlinks: Windows may not be allowed to create Unix links.
release_capture(entries "${CMAKE_COMMAND}" -E tar tf "${ARCHIVE}")
function(require_payload pattern)
    if(NOT entries MATCHES "(^|\n)${stem}/${pattern}(\r?\n|$)")
        message(FATAL_ERROR "Desktop archive is missing a payload matching ${pattern}")
    endif()
endfunction()
foreach(module IN ITEMS Core Gui Widgets Network)
    if(target STREQUAL "windows-x64")
        release_file("${bin}/Qt6${module}.dll")
    elseif(target STREQUAL "linux-x64")
        require_payload("[^\n]*/libQt6${module}[.]so[.]6")
    else()
        require_payload("MosaicraftDesktop[.]app/Contents/Frameworks/Qt${module}[.]framework/Versions/[^/\n]+/Qt${module}")
    endif()
endforeach()
if(target STREQUAL "windows-x64")
    foreach(plugin IN ITEMS imageformats/qwebp imageformats/qtiff platforms/qwindows)
        require_payload("[^\n]*/${plugin}[.]dll")
    endforeach()
elseif(target STREQUAL "linux-x64")
    foreach(icu IN ITEMS icudata icui18n icuuc)
        require_payload("[^\n]*/lib${icu}[.]so[.]73")
    endforeach()
    foreach(plugin IN ITEMS imageformats/libqwebp imageformats/libqtiff platforms/libqxcb platforms/libqwayland)
        require_payload("[^\n]*/${plugin}[.]so")
    endforeach()
else()
    foreach(plugin IN ITEMS imageformats/libqwebp imageformats/libqtiff platforms/libqcocoa)
        release_file("${app}/PlugIns/${plugin}.dylib")
    endforeach()
endif()
file(READ "${root}/BUILD_INFO.txt" info)
foreach(key IN ITEMS Version Platform Runtime GitCommit QtVersion GpuValidation PortableGpuValidation PortableAutoSelection CudaBackend VulkanBackend)
    release_field("${info}" "${key}" "${key}")
endforeach()
file(READ "${bin}/contracts.json" contracts)
string(JSON software GET "${contracts}" softwareVersion)
if(NOT Version STREQUAL version OR NOT software STREQUAL version OR NOT Platform STREQUAL target OR
   (DEFINED EXPECTED_COMMIT AND NOT GitCommit STREQUAL EXPECTED_COMMIT))
    message(FATAL_ERROR "Desktop archive provenance or version mismatch")
endif()
if(NOT QtVersion STREQUAL "")
    foreach(module IN ITEMS qtbase qtimageformats qttranslations)
        release_file("${root}/licenses/qt/${module}-${QtVersion}.cdx.json")
    endforeach()
endif()
if(gpu)
    if(NOT Runtime STREQUAL "cuda-vulkan" OR NOT CudaBackend STREQUAL "enabled" OR NOT VulkanBackend STREQUAL "enabled" OR
       NOT GpuValidation MATCHES "^(passed|not-run)$" OR NOT PortableGpuValidation STREQUAL GpuValidation OR
       NOT PortableAutoSelection STREQUAL "cuda-to-cpu" OR (candidate AND NOT GpuValidation STREQUAL "not-run") OR
       ((REQUIRE_GPU OR (target STREQUAL "windows-x64" AND NOT candidate)) AND NOT GpuValidation STREQUAL "passed"))
        message(FATAL_ERROR "Incorrect desktop GPU metadata")
    endif()
    require_payload("bin/licenses/cuda/[^/\n]+")
    if(target STREQUAL "linux-x64")
        require_payload("bin/lib/libcudart[.]so[.][^/\n]+")
    endif()
elseif(NOT Runtime STREQUAL "cpu-only")
    message(FATAL_ERROR "Incorrect desktop CPU metadata")
endif()
if(RUN_SMOKE)
    release_host(host arch suffix)
    if(NOT target STREQUAL "${host}-${arch}" OR host STREQUAL "macos")
        message(FATAL_ERROR "Run desktop smoke on the target Windows/Linux platform")
    endif()
    # Never load development plugins or SDK libraries during the archive smoke.
    foreach(key IN ITEMS LD_LIBRARY_PATH LD_PRELOAD QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH)
        unset(ENV{${key}})
    endforeach()
    set(ENV{MOSAICRAFT_DESKTOP_SMOKE_CLI} "${bin}/mosaicraft${exe}")
    if(host STREQUAL "windows")
        set(ENV{PATH} "$ENV{WINDIR}/System32;$ENV{WINDIR}")
        set(qpa windows)
        set(display)
    else()
        set(ENV{PATH} /usr/bin:/bin)
        set(ENV{QT_DEBUG_PLUGINS} 1)
        set(qpa xcb)
        set(display xvfb-run -a)
    endif()
    execute_process(COMMAND ${display} "${bin}/MosaicraftDesktop${exe}" --smoke-test -platform "${qpa}"
        WORKING_DIRECTORY "${work}" TIMEOUT 180 COMMAND_ERROR_IS_FATAL ANY)
    if(gpu)
        include("${CMAKE_CURRENT_LIST_DIR}/DesktopGpuSmoke.cmake")
        desktop_gpu_smoke("${bin}" "${exe}" "${work}" "${REQUIRE_GPU}")
    endif()
endif()
if(NOT KEEP_WORKSPACE)
    file(REMOVE_RECURSE "${work}")
endif()
message(STATUS "Verified desktop archive: ${name} (SHA256 ${sha})")
