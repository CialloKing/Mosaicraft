# Resolve every used CUDA component under one explicit SDK, rather than combining
# a new root with FindCUDAToolkit paths retained in an older build directory.
file(READ "${CMAKE_CURRENT_LIST_DIR}/cuda-13.5.json" _cuda_lock)
string(JSON _cuda_version GET "${_cuda_lock}" components cuda_nvcc version)
if(NOT CUDAToolkit_ROOT AND DEFINED ENV{CUDAToolkit_ROOT})
    set(CUDAToolkit_ROOT "$ENV{CUDAToolkit_ROOT}")
endif()
if(NOT CUDAToolkit_ROOT OR NOT IS_DIRECTORY "${CUDAToolkit_ROOT}")
    message(FATAL_ERROR "Set CUDAToolkit_ROOT explicitly to CUDA ${_cuda_version}; PATH and CUDA_PATH are not used. CPU builds can use MOSAICRAFT_CUDA=OFF.")
endif()
file(REAL_PATH "${CUDAToolkit_ROOT}" _cuda_root)
set(CUDAToolkit_ROOT "${_cuda_root}" CACHE PATH "Locked CUDA SDK root" FORCE)

function(mosaicraft_check_cuda_path label path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "CUDA ${label} is missing: ${path}. Use a fresh build directory with CUDA ${_cuda_version}.")
    endif()
    file(REAL_PATH "${path}" _path)
    cmake_path(IS_PREFIX _cuda_root "${_path}" NORMALIZE _under_root)
    if(NOT _under_root)
        message(FATAL_ERROR "Mixed CUDA SDK/cache: ${label}=${path} is outside CUDAToolkit_ROOT=${_cuda_root}. Use a fresh build directory.")
    endif()
endfunction()

foreach(_variable IN ITEMS CUDAToolkit_NVCC_EXECUTABLE CUDAToolkit_BIN_DIR CMAKE_CUDA_COMPILER
    CUDA_TOOLKIT_INCLUDE CUDAToolkit_INCLUDE_DIR CUDA_CUDART CUDA_cudart_LIBRARY)
    if(${_variable})
        mosaicraft_check_cuda_path("${_variable}" "${${_variable}}")
    endif()
endforeach()
set(_cuda_nvcc "${_cuda_root}/bin/nvcc${CMAKE_EXECUTABLE_SUFFIX}")
mosaicraft_check_cuda_path(nvcc "${_cuda_nvcc}")
execute_process(COMMAND "${_cuda_nvcc}" --version RESULT_VARIABLE _result OUTPUT_VARIABLE _version ERROR_VARIABLE _error)
string(REGEX MATCH "V([0-9]+\\.[0-9]+\\.[0-9]+)" _match "${_version}")
if(NOT _result EQUAL 0 OR NOT CMAKE_MATCH_1 VERSION_EQUAL _cuda_version)
    message(FATAL_ERROR "CUDA requires nvcc ${_cuda_version}, got: ${_version}${_error}. Use a fresh CUDA 13.5 build directory.")
endif()
find_package(CUDAToolkit ${_cuda_version} EXACT REQUIRED)
foreach(_path IN LISTS CUDAToolkit_INCLUDE_DIRS)
    mosaicraft_check_cuda_path(include "${_path}")
endforeach()
mosaicraft_check_cuda_path(nvcc "${CUDAToolkit_NVCC_EXECUTABLE}")
get_target_property(_cuda_runtime CUDA::cudart IMPORTED_LOCATION)
mosaicraft_check_cuda_path(cudart "${_cuda_runtime}")
foreach(_header IN ITEMS cuda.h cuda_runtime_api.h)
    file(STRINGS "${_cuda_root}/include/${_header}" _header_version REGEX "^#define +CUDA(RT)?_VERSION +[0-9]+")
    if(NOT _header_version MATCHES " +13050$")
        message(FATAL_ERROR "CUDA header ${_header} must belong to 13.5: ${_header_version}")
    endif()
endforeach()
if(WIN32)
    set(CUDA_RUNTIME_MODE hybrid)
else()
    set(CUDA_RUNTIME_MODE shared)
endif()
message(STATUS "CUDA: enabled (${CUDAToolkit_VERSION}, ${CUDA_RUNTIME_MODE}, ${_cuda_root})")
