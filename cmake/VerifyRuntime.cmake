function(verify_runtime root host suffix)
    # This function changes only the script process and its children. Standalone runs must not
    # find development libraries, even when they follow packaging on the build machine.
    if(host STREQUAL "windows")
        set(ENV{PATH} "$ENV{WINDIR}/System32;$ENV{WINDIR}")
        return()
    endif()
    set(ENV{LD_LIBRARY_PATH} "")
    set(ENV{DYLD_LIBRARY_PATH} "")
    set(ENV{DYLD_FALLBACK_LIBRARY_PATH} "")
    file(GLOB libraries LIST_DIRECTORIES FALSE "${root}/lib/*.dylib" "${root}/lib/*.so*")
    foreach(exe IN ITEMS "${root}/mosaicraft${suffix}" "${root}/MosaicraftWebUI${suffix}")
        execute_process(COMMAND test -x "${exe}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    foreach(binary IN ITEMS "${root}/mosaicraft${suffix}" "${root}/MosaicraftWebUI${suffix}" ${libraries})
        if(IS_SYMLINK "${binary}")
            file(REAL_PATH "${binary}" resolved)
            cmake_path(IS_PREFIX root "${resolved}" NORMALIZE inside)
            if(NOT inside OR NOT EXISTS "${resolved}")
                message(FATAL_ERROR "Unresolved or external archive link: ${binary}")
            endif()
            continue()
        endif()
        if(host STREQUAL "macos")
            execute_process(COMMAND codesign --verify "${binary}" COMMAND_ERROR_IS_FATAL ANY)
            release_capture(loads otool -L "${binary}")
            string(REGEX MATCHALL "\n[ \t]+[^\n]+" lines "${loads}")
            get_filename_component(loader "${binary}" DIRECTORY)
            foreach(line IN LISTS lines)
                string(STRIP "${line}" line)
                string(REGEX REPLACE " \\(compatibility version .*$" "" path "${line}")
                if(path MATCHES "^(/usr/lib/|/System/Library/)")
                    continue()
                elseif(path MATCHES "^@loader_path/")
                    string(REPLACE "@loader_path" "${loader}" path "${path}")
                elseif(path MATCHES "^@rpath/")
                    string(REPLACE "@rpath" "${root}/lib" path "${path}")
                else()
                    message(FATAL_ERROR "Non-relative macOS dependency: ${path}")
                endif()
                file(REAL_PATH "${path}" resolved)
                cmake_path(IS_PREFIX root "${resolved}" NORMALIZE inside)
                if(NOT inside OR NOT EXISTS "${resolved}")
                    message(FATAL_ERROR "Missing or external macOS dependency: ${path}")
                endif()
            endforeach()
        else()
            release_capture(loads ldd "${binary}")
            if(loads MATCHES "not found")
                message(FATAL_ERROR "Unresolved Linux dependency: ${binary}\n${loads}")
            endif()
            string(REGEX MATCHALL "=>[ \t]+/[^\n]+" lines "${loads}")
            foreach(line IN LISTS lines)
                string(REGEX REPLACE "^=>[ \t]+|[ \t]+\\(0x[0-9a-fA-F]+\\)$" "" path "${line}")
                file(REAL_PATH "${path}" resolved)
                cmake_path(IS_PREFIX root "${resolved}" NORMALIZE inside)
                get_filename_component(name "${resolved}" NAME)
                if(NOT inside AND NOT name MATCHES "^lib(c|m|dl|pthread|rt|gcc_s|stdc\\+\\+)\\.so")
                    message(FATAL_ERROR "Linux dependency escaped the archive: ${resolved}")
                endif()
            endforeach()
        endif()
    endforeach()
endfunction()
