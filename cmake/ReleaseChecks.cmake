include_guard(GLOBAL)
set(MOSAICRAFT_REPO "${CMAKE_CURRENT_LIST_DIR}/..")
set(MOSAICRAFT_NATIVE "sm_75;sm_80;sm_86;sm_89;sm_90;sm_100;sm_120")
string(REPLACE "sm_" "compute_" MOSAICRAFT_PTX "${MOSAICRAFT_NATIVE}")

function(release_capture result)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE ENCODING UTF-8)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}): ${ARGV1}\n${output}\n${error}")
    endif()
    set(${result} "${output}" PARENT_SCOPE)
endfunction()

function(release_file path)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Required file missing: ${path}")
    endif()
endfunction()

# Read one field without treating semicolon-separated CUDA architectures as a CMake list.
function(release_field text key result)
    string(REPLACE "." "\\." pattern "${key}")
    string(REGEX MATCHALL "(^|\n)${pattern}:[ \t]*[^\r\n]*" matches "${text}")
    string(REGEX MATCH "(^|\n)${pattern}:[ \t]*([^\r\n]*)" match "${text}")
    set(value "${CMAKE_MATCH_2}")
    if(NOT "${match}" STREQUAL "${matches}")
        message(FATAL_ERROR "Duplicate metadata field: ${key}")
    endif()
    string(STRIP "${value}" value)
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(release_host platform arch extension)
    cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
    string(TOLOWER "${processor}" processor)
    if(CMAKE_HOST_WIN32 AND processor MATCHES "^(x86_64|amd64)$")
        set(values windows x64 .exe)
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND processor MATCHES "^(x86_64|amd64)$")
        set(values linux x64 "")
    elseif(CMAKE_HOST_APPLE AND processor MATCHES "^(arm64|aarch64)$")
        set(values macos arm64 "")
    else()
        message(FATAL_ERROR "Unsupported native release host: ${CMAKE_HOST_SYSTEM_NAME}/${processor}")
    endif()
    list(GET values 0 p)
    list(GET values 1 a)
    list(GET values 2 e)
    set(${platform} "${p}" PARENT_SCOPE)
    set(${arch} "${a}" PARENT_SCOPE)
    set(${extension} "${e}" PARENT_SCOPE)
endfunction()

function(release_cuda_metadata text)
    foreach(field IN ITEMS Runtime Platform GpuValidation CudaArchitectures CudaPtx CudaToolkit
            CudaRuntimeMode GpuValidationRuntime GpuValidationDevice GpuValidationComputeCapability GpuValidationDriver)
        release_field("${text}" "${field}" ${field})
    endforeach()
    set(probe_fields GpuValidationDevice GpuValidationComputeCapability GpuValidationDriver)
    if(CudaArchitectures STREQUAL "" AND CudaPtx STREQUAL "" AND CudaToolkit STREQUAL "" AND
       CudaRuntimeMode STREQUAL "" AND GpuValidationRuntime STREQUAL "" AND
       GpuValidationDevice STREQUAL "" AND GpuValidationComputeCapability STREQUAL "" AND GpuValidationDriver STREQUAL "")
        return() # Historical archives did not include these fields.
    endif()
    if(NOT Runtime MATCHES "^(cuda|cuda-vulkan)$" OR NOT
       ((CudaArchitectures STREQUAL MOSAICRAFT_NATIVE AND CudaPtx STREQUAL MOSAICRAFT_PTX) OR
        (CudaArchitectures STREQUAL "sm_75;sm_80;sm_86;sm_89;sm_90;sm_120" AND CudaPtx STREQUAL "compute_75")))
        message(FATAL_ERROR "Incomplete, misplaced or invalid CUDA architecture metadata")
    endif()
    if(NOT CudaToolkit STREQUAL "" OR NOT CudaRuntimeMode STREQUAL "" OR NOT GpuValidationRuntime STREQUAL "")
        if(NOT CudaToolkit MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" OR NOT
           ((Platform STREQUAL "windows" AND CudaRuntimeMode STREQUAL "hybrid") OR
            (Platform STREQUAL "linux" AND CudaRuntimeMode STREQUAL "shared")))
            message(FATAL_ERROR "Incomplete or invalid CUDA toolkit/runtime metadata")
        endif()
        list(APPEND probe_fields GpuValidationRuntime)
        if(GpuValidation STREQUAL "passed" AND NOT GpuValidationRuntime MATCHES "^[1-9][0-9]+$")
            message(FATAL_ERROR "Missing actual CUDA runtime version")
        endif()
    endif()
    if(GpuValidation STREQUAL "not-run")
        foreach(field IN LISTS probe_fields)
            if(NOT ${field} STREQUAL "not-run")
                message(FATAL_ERROR "An unvalidated package must not claim ${field}")
            endif()
        endforeach()
    elseif(NOT GpuValidation STREQUAL "passed" OR GpuValidationDevice STREQUAL "" OR
           GpuValidationDevice STREQUAL "not-run" OR NOT GpuValidationComputeCapability MATCHES "^sm_[0-9]+$" OR
           NOT GpuValidationDriver MATCHES "^[1-9][0-9]+$")
        message(FATAL_ERROR "Invalid CUDA acceptance state or device evidence")
    endif()
endfunction()

function(release_cuda_images inspector path modules)
    foreach(kind IN ITEMS elf ptx)
        release_capture(listing "${inspector}" "--list-${kind}" "${path}")
        string(REGEX MATCHALL "\\.sm_[0-9]+\\.(cubin|ptx)" images "${listing}")
        math(EXPR expected "7 * ${modules}")
        list(LENGTH images count)
        if(NOT count EQUAL expected)
            message(FATAL_ERROR "Unexpected ${kind} image count in ${path}: ${listing}")
        endif()
        foreach(target IN LISTS MOSAICRAFT_NATIVE)
            set(group "${images}")
            list(FILTER group INCLUDE REGEX "^\\.${target}\\.(cubin|ptx)$")
            list(LENGTH group count)
            if(NOT count EQUAL modules)
                message(FATAL_ERROR "Missing or repeated ${target} ${kind} images in ${path}")
            endif()
        endforeach()
    endforeach()
endfunction()
