function(mosaicraft_windows_host_architecture out)
    cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
    string(TOLOWER "${processor}" processor)
    if(processor MATCHES "^(amd64|x86_64|x64)$")
        set(${out} x64 PARENT_SCOPE)
    elseif(processor MATCHES "^(arm64|aarch64)$")
        set(${out} arm64 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Windows dependencies require an x64 or ARM64 host; detected ${processor}")
    endif()
endfunction()
