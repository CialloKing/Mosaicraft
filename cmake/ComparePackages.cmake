cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")

# VerifyPackage runs both packages separately. Compare their layout and acceptance
# evidence here; executable bytes and archive timestamps are not reproducibility gates.
release_file("${NEW_ARCHIVE}")
release_file("${LEGACY_ARCHIVE}")
get_filename_component(new_name "${NEW_ARCHIVE}" NAME)
get_filename_component(old_name "${LEGACY_ARCHIVE}" NAME)
if(NOT new_name STREQUAL old_name)
    message(FATAL_ERROR "Different attachment names: ${new_name} vs ${old_name}")
endif()

function(inventory archive out)
    release_capture(listing "${CMAKE_COMMAND}" -E tar tvf "${archive}")
    string(REPLACE ";" "\\;" listing "${listing}")
    string(REPLACE "\n" ";" lines "${listing}")
    set(values)
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^([dl-][rwxstST-]+) +[0-9]+ +[^ ]+ +[^ ]+ +[0-9]+ +[A-Za-z0-9]+ +[A-Za-z0-9]+ +[0-9:]+ (.+)$")
            message(FATAL_ERROR "Unrecognized archive listing: ${line}")
        endif()
        set(mode "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "^\\./" "" path "${CMAKE_MATCH_2}")
        # A ZIP can omit explicit directory entries. Compare files and links only.
        if(mode MATCHES "^d")
            continue()
        endif()
        if(NOT CMAKE_HOST_WIN32)
            string(APPEND path " | ${mode}")
        endif()
        list(APPEND values "${path}")
    endforeach()
    list(SORT values)
    set(${out} "${values}" PARENT_SCOPE)
endfunction()

inventory("${NEW_ARCHIVE}" new_files)
inventory("${LEGACY_ARCHIVE}" old_files)
if(NOT new_files STREQUAL old_files)
    set(added "${new_files}")
    set(removed "${old_files}")
    list(REMOVE_ITEM added ${old_files})
    list(REMOVE_ITEM removed ${new_files})
    message(FATAL_ERROR "Archive layout, permissions or symlinks differ:\nNew only: ${added}\nLegacy only: ${removed}")
endif()

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${CMAKE_CURRENT_BINARY_DIR}/build/compare-release-${nonce}")
file(MAKE_DIRECTORY "${work}/legacy" "${work}/new")
message(STATUS "Comparison workspace: ${work}")
file(ARCHIVE_EXTRACT INPUT "${NEW_ARCHIVE}" DESTINATION "${work}/new")
file(ARCHIVE_EXTRACT INPUT "${LEGACY_ARCHIVE}" DESTINATION "${work}/legacy")
file(GLOB_RECURSE documents RELATIVE "${work}/new" LIST_DIRECTORIES FALSE "${work}/new/docs/*" "${work}/new/licenses/*")
list(APPEND documents README.md LICENSE CMakeUserPresets.example.json contracts.json third_party_versions.txt)
foreach(path IN LISTS documents)
    file(SHA256 "${work}/new/${path}" actual)
    file(SHA256 "${work}/legacy/${path}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Documentation or license differs: ${path}")
    endif()
endforeach()
foreach(layout IN ITEMS new legacy)
    file(STRINGS "${work}/${layout}/BUILD_INFO.txt" fields ENCODING UTF-8)
    list(FILTER fields EXCLUDE REGEX "^GeneratedAtUtc:")
    list(SORT fields)
    set(${layout}_fields "${fields}")
endforeach()
if(NOT new_fields STREQUAL legacy_fields)
    message(FATAL_ERROR "Release metadata differs:\nNew: ${new_fields}\nLegacy: ${legacy_fields}")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Archive contents, metadata and platform layout match: ${new_name}")
