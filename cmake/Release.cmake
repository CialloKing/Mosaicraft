cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")

if(NOT RUNTIME MATCHES "^(cpu-only|cuda|vulkan|cuda-vulkan|metal)$")
    message(FATAL_ERROR "RUNTIME is required: cpu-only, cuda, vulkan, cuda-vulkan or metal")
endif()
if(NOT DEFINED CHANNEL)
    set(CHANNEL stable)
endif()
if(NOT CHANNEL MATCHES "^(stable|candidate)$")
    message(FATAL_ERROR "CHANNEL must be stable or candidate")
endif()
release_host(platform arch suffix)
set(preset "${platform}-${arch}")
set(cuda OFF)
set(vulkan OFF)
set(vulkan_auto OFF)
set(metal OFF)
set(gpu_validation not-applicable)
if(RUNTIME STREQUAL "cpu-only")
    if(NOT CHANNEL STREQUAL "stable")
        message(FATAL_ERROR "CPU packages use the stable release layout")
    endif()
elseif(RUNTIME STREQUAL "metal")
    if(NOT platform STREQUAL "macos" OR NOT CHANNEL STREQUAL "candidate")
        message(FATAL_ERROR "Metal packaging supports native macOS ARM64 candidates only")
    endif()
    set(metal ON)
    set(gpu_validation not-run)
else()
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "CUDA and Vulkan packages are supported on Windows/Linux x64 only")
    endif()
    set(gpu_validation not-run)
    if(RUNTIME MATCHES "vulkan")
        set(vulkan ON)
        if(RUNTIME STREQUAL "vulkan" AND CHANNEL STREQUAL "stable")
            set(vulkan_auto ON)
        endif()
    endif()
    if(RUNTIME MATCHES "^cuda")
        set(cuda ON)
        if(RUNTIME STREQUAL "cuda-vulkan" AND NOT SMART_CROP_VULKAN AND
           (NOT platform STREQUAL "windows" OR NOT CHANNEL STREQUAL "candidate"))
            message(FATAL_ERROR "The combined backend supports Windows x64 candidates only")
        endif()
        if(NOT DEFINED CUDA_VALIDATION)
            set(CUDA_VALIDATION Required)
        endif()
        if(NOT CUDA_VALIDATION MATCHES "^(Required|BuildOnly)$")
            message(FATAL_ERROR "CUDA_VALIDATION must be Required or BuildOnly")
        endif()
        if(CHANNEL STREQUAL "stable" AND CUDA_VALIDATION STREQUAL "BuildOnly" AND
           NOT (platform STREQUAL "linux" AND ALLOW_UNVALIDATED_LINUX_CUDA))
            message(FATAL_ERROR "Stable Windows CUDA requires real GPU validation; Linux BuildOnly requires explicit opt-in")
        endif()
    endif()
endif()
if(DEFINED CUDA_VALIDATION AND NOT cuda)
    message(FATAL_ERROR "CUDA_VALIDATION is only meaningful for a CUDA build")
endif()

foreach(option IN ITEMS SMART_CROP SMART_CROP_CUDA SMART_CROP_CUTLASS SMART_CROP_VULKAN)
    if(${option})
        set(${option} ON)
    else()
        set(${option} OFF)
    endif()
endif()
if(SMART_CROP_VULKAN OR SMART_CROP_CUTLASS)
    if(NOT SMART_CROP OR NOT SMART_CROP_CUDA OR NOT SMART_CROP_VULKAN OR NOT SMART_CROP_CUTLASS OR
       NOT RUNTIME STREQUAL "cuda-vulkan" OR NOT arch STREQUAL "x64")
        message(FATAL_ERROR "The dual smart crop archive needs both CUDA (CUTLASS) and Vulkan on x64")
    endif()
elseif(SMART_CROP_CUDA)
    if(NOT SMART_CROP OR NOT platform STREQUAL "windows" OR NOT arch STREQUAL "x64" OR
       NOT RUNTIME STREQUAL "cuda" OR NOT CUDA_VALIDATION STREQUAL "Required" OR
       NOT IS_ABSOLUTE "${SMART_CROP_CUDA_REDIST}")
        message(FATAL_ERROR "CUDA smart crop requires Windows x64, Required GPU validation, and an approved redist tree")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
    smart_crop_cuda_redist("${MOSAICRAFT_REPO}" "${SMART_CROP_CUDA_REDIST}" approved_dlls approved_notices)
    # Tests load OpenCV DNN before the install tree exists, so expose only the
    # audited smart-crop CUDA runtime while the release checks execute.
    set(ENV{PATH} "${SMART_CROP_CUDA_REDIST};$ENV{PATH}")
elseif(SMART_CROP AND (NOT platform STREQUAL "macos" OR NOT RUNTIME STREQUAL "cpu-only"))
    message(FATAL_ERROR "The CPU smart crop archive targets macOS ARM64")
endif()

find_program(git git REQUIRED)
release_capture(status "${git}" -C "${MOSAICRAFT_REPO}" status --porcelain --untracked-files=normal)
if(NOT status STREQUAL "")
    message(FATAL_ERROR "Package only a clean, committed workspace:\n${status}")
endif()
release_capture(commit "${git}" -C "${MOSAICRAFT_REPO}" rev-parse HEAD)
file(READ "${MOSAICRAFT_REPO}/contracts.json" contracts)
string(JSON version GET "${contracts}" softwareVersion)
file(STRINGS "${MOSAICRAFT_REPO}/docs/releases.md" release_titles REGEX "^## v")
if("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag" AND NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "v${version}")
    message(FATAL_ERROR "Release tag does not match contracts.json")
endif()
if(NOT "## v${version}" IN_LIST release_titles)
    message(FATAL_ERROR "No release heading for v${version} in docs/releases.md")
endif()

if(NOT DEFINED VCPKG_ROOT)
    set(VCPKG_ROOT "$ENV{VCPKG_ROOT}")
endif()
release_file("${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
file(REAL_PATH "${VCPKG_ROOT}" VCPKG_ROOT)
set(ENV{VCPKG_ROOT} "${VCPKG_ROOT}")
file(READ "${MOSAICRAFT_REPO}/vcpkg.json" manifest)
string(JSON baseline GET "${manifest}" builtin-baseline)
release_capture(vcpkg_head "${git}" -C "${VCPKG_ROOT}" rev-parse HEAD)
if(NOT vcpkg_head STREQUAL baseline)
    message(FATAL_ERROR "Native packages require the locked vcpkg checkout: ${baseline}")
endif()
set(os_triplet "${platform}")
if(platform STREQUAL "macos")
    set(os_triplet osx)
endif()
set(triplet "${arch}-${os_triplet}-release")
if(NOT DEFINED VCPKG_INSTALLED_DIR)
    set(VCPKG_INSTALLED_DIR "$ENV{MOSAICRAFT_VCPKG_INSTALLED_DIR}")
    if(VCPKG_INSTALLED_DIR STREQUAL "")
        set(VCPKG_INSTALLED_DIR "${MOSAICRAFT_REPO}/third_party/vcpkg_installed")
    endif()
endif()
file(REAL_PATH "${VCPKG_INSTALLED_DIR}" VCPKG_INSTALLED_DIR)
if(NOT IS_DIRECTORY "${VCPKG_INSTALLED_DIR}/${triplet}")
    message(FATAL_ERROR "Install the locked ${triplet} dependencies first: ${VCPKG_INSTALLED_DIR}")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest ctest PATHS "${cmake_bin}" NO_DEFAULT_PATH REQUIRED)
find_program(cpack cpack PATHS "${cmake_bin}" NO_DEFAULT_PATH REQUIRED)
if(NOT DEFINED BUILD_DIR)
    set(BUILD_DIR "${MOSAICRAFT_REPO}/build/release-${preset}-${RUNTIME}-${CHANNEL}")
    if(SMART_CROP)
        string(APPEND BUILD_DIR "-smart-crop")
    endif()
endif()
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${MOSAICRAFT_REPO}/build/archives")
endif()
file(REAL_PATH "${MOSAICRAFT_REPO}" repo)
cmake_path(ABSOLUTE_PATH BUILD_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
set(bin "${BUILD_DIR}/Release/bin")
set(sdk_args)
if(cuda)
    # A reused developer build can retain a single-device CUDA_ARCH cache entry.
    string(REPLACE ";" "\\;" release_architectures "${MOSAICRAFT_NATIVE}")
    list(APPEND sdk_args "-DCUDA_ARCH:STRING=${release_architectures}")
    if(DEFINED CUDAToolkit_ROOT)
        list(APPEND sdk_args "-DCUDAToolkit_ROOT=${CUDAToolkit_ROOT}")
    endif()
endif()
if(vulkan)
    foreach(key IN ITEMS MOSAICRAFT_VULKAN_INCLUDE MOSAICRAFT_GLSLANG)
        if(DEFINED ${key})
            list(APPEND sdk_args "-D${key}=${${key}}")
        endif()
    endforeach()
endif()
if(SMART_CROP)
    include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
    file(READ "${repo}/cmake/smart-crop-models.json" smart_crop_lock)
    smart_crop_release_gate("${repo}" "${smart_crop_lock}" "${platform}-${arch}-${RUNTIME}-smart-crop")
    if(NOT DEFINED SMART_CROP_FIXTURE_ROOT)
        set(SMART_CROP_FIXTURE_ROOT "$ENV{SMART_CROP_FIXTURE_ROOT}")
    endif()
    if(SMART_CROP_FIXTURE_ROOT STREQUAL "")
        message(FATAL_ERROR "Smart crop packages require SMART_CROP_FIXTURE_ROOT for independent face-crop checks")
    endif()
    cmake_path(ABSOLUTE_PATH SMART_CROP_FIXTURE_ROOT BASE_DIRECTORY "${repo}" NORMALIZE)
    smart_crop_verify_fixtures("${SMART_CROP_FIXTURE_ROOT}" "${smart_crop_lock}")
    if(NOT DEFINED SMART_CROP_MODELS_DIR)
        set(SMART_CROP_MODELS_DIR "${repo}/build/smart-crop-models/prepared")
    endif()
    cmake_path(ABSOLUTE_PATH SMART_CROP_MODELS_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
    smart_crop_verified_models("${smart_crop_lock}" "${SMART_CROP_MODELS_DIR}" validated_models)
    if(SMART_CROP_VULKAN)
        foreach(key IN ITEMS MOSAICRAFT_NCNN_DIR MOSAICRAFT_NCNN_LICENSE)
            if(NOT DEFINED ${key})
                set(${key} "$ENV{${key}}")
            endif()
        endforeach()
        if(NOT DEFINED SMART_CROP_VULKAN_MODELS_DIR)
            set(SMART_CROP_VULKAN_MODELS_DIR "${SMART_CROP_MODELS_DIR}/vulkan")
        endif()
        cmake_path(ABSOLUTE_PATH SMART_CROP_VULKAN_MODELS_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
        release_file("${MOSAICRAFT_NCNN_DIR}/ncnnConfig.cmake")
        release_file("${MOSAICRAFT_NCNN_LICENSE}")
        list(APPEND sdk_args "-Dncnn_DIR:PATH=${MOSAICRAFT_NCNN_DIR}"
            "-DMOSAICRAFT_NCNN_LICENSE:FILEPATH=${MOSAICRAFT_NCNN_LICENSE}"
            "-DMOSAICRAFT_SMART_CROP_VULKAN_MODELS_DIR:PATH=${SMART_CROP_VULKAN_MODELS_DIR}")
    endif()
endif()
message(STATUS "Building v${version} ${platform}-${arch} ${RUNTIME} (${CHANNEL}) at ${commit}")
execute_process(COMMAND "${CMAKE_COMMAND}" --preset "${preset}" -S "${repo}" -B "${BUILD_DIR}"
    "-DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    "-DVCPKG_INSTALLED_DIR=${VCPKG_INSTALLED_DIR}" "-DVCPKG_OVERLAY_TRIPLETS=${repo}/cmake/triplets"
    "-DVCPKG_TARGET_TRIPLET=${triplet}" "-DVCPKG_HOST_TRIPLET=${triplet}" -DVCPKG_MANIFEST_INSTALL=OFF
    "-DMOSAICRAFT_CUDA:BOOL=${cuda}" "-DMOSAICRAFT_VULKAN:BOOL=${vulkan}" "-DMOSAICRAFT_METAL:BOOL=${metal}"
    "-DMOSAICRAFT_VULKAN_AUTO:BOOL=${vulkan_auto}" -DMOSAICRAFT_BUNDLE_RUNTIME:BOOL=ON
    -DMOSAICRAFT_DESKTOP_BACKEND_INSTALL:BOOL=OFF -DMOSAICRAFT_BUILD_DESKTOP:BOOL=OFF
    "-DMOSAICRAFT_SMART_CROP_CUDA:BOOL=${SMART_CROP_CUDA}"
    "-DMOSAICRAFT_SMART_CROP_CUTLASS:BOOL=${SMART_CROP_CUTLASS}" "-DMOSAICRAFT_SMART_CROP_VULKAN:BOOL=${SMART_CROP_VULKAN}"
    "-DMOSAICRAFT_SMART_CROP_CUDA_REDIST:PATH=${SMART_CROP_CUDA_REDIST}"
    "-DMOSAICRAFT_SMART_CROP:BOOL=${SMART_CROP}" "-DMOSAICRAFT_SMART_CROP_MODELS_DIR:PATH=${SMART_CROP_MODELS_DIR}" ${sdk_args}
    COMMAND_ERROR_IS_FATAL ANY)
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" cache)
set(expected_cache "MOSAICRAFT_CUDA:BOOL=${cuda}" "MOSAICRAFT_VULKAN:BOOL=${vulkan}"
    "MOSAICRAFT_METAL:BOOL=${metal}" "MOSAICRAFT_VULKAN_AUTO:BOOL=${vulkan_auto}"
    "MOSAICRAFT_SMART_CROP_CUDA:BOOL=${SMART_CROP_CUDA}" "MOSAICRAFT_SMART_CROP_CUTLASS:BOOL=${SMART_CROP_CUTLASS}"
    "MOSAICRAFT_SMART_CROP_VULKAN:BOOL=${SMART_CROP_VULKAN}" "MOSAICRAFT_BUNDLE_RUNTIME:BOOL=ON"
    "MOSAICRAFT_DESKTOP_BACKEND_INSTALL:BOOL=OFF" "MOSAICRAFT_SMART_CROP:BOOL=${SMART_CROP}")
foreach(entry IN LISTS expected_cache)
    if(NOT entry IN_LIST cache)
        message(FATAL_ERROR "Release cache does not contain ${entry}")
    endif()
endforeach()
set(cuda_info "")
set(probe "")
set(ENV{MOSAICRAFT_REQUIRE_CUDA} 0)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config Release --target mosaicraft_test_targets
    --parallel COMMAND_ERROR_IS_FATAL ANY)

if(cuda)
    release_inspect_cuda("${BUILD_DIR}" "${suffix}" "${platform}" "${CMAKE_CURRENT_LIST_DIR}/cuda-13.5.json"
        cuda_info mosaicraft MosaicraftWebUI)
    if(CUDA_VALIDATION STREQUAL "Required")
        release_capture(probe "${bin}/mosaicraft_tests${suffix}" --require-cuda)
        if(NOT probe MATCHES "(^|\n)GPU validation passed(\r?\n|$)")
            message(FATAL_ERROR "CUDA GPU probe did not pass")
        endif()
        set(ENV{MOSAICRAFT_REQUIRE_CUDA} 1)
        set(gpu_validation passed)
    else()
        # BuildOnly must never be mistaken for successful real-device acceptance.
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env CUDA_VISIBLE_DEVICES=-1
            "${bin}/mosaicraft_tests${suffix}" --require-cuda RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(status STREQUAL "0" OR NOT "${output}\n${error}" MATCHES "requires an available CUDA device")
            message(FATAL_ERROR "Unexpected CUDA-required result without a device: ${status}\n${output}\n${error}")
        endif()
    endif()
endif()

# A missing test (including one never registered) must fail before staging anything.
set(mandatory cuda_architecture_config cuda_toolkit_config cuda_build_info_native
    mosaicraft_tests mosaicraft_regression_tests documentation_native webui_native_smoke)
release_capture(test_listing "${ctest}" --test-dir "${BUILD_DIR}" -C Release --show-only=json-v1)
string(JSON count LENGTH "${test_listing}" tests)
if(count LESS 1)
    message(FATAL_ERROR "The mandatory release CTest suite is empty")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON test_name GET "${test_listing}" tests ${index} name)
    list(APPEND registered "${test_name}")
endforeach()
foreach(test_name IN LISTS mandatory)
    if(NOT test_name IN_LIST registered)
        message(FATAL_ERROR "Mandatory release test not registered: ${test_name}")
    endif()
endforeach()
list(JOIN mandatory "|" pattern)
execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}" -C Release -R "^(${pattern})$"
    --output-on-failure --no-tests=error COMMAND_ERROR_IS_FATAL ANY)

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${OUTPUT_DIR}/.mosaicraft-${nonce}")
set(stage "${work}/stage")
set(archive_dir "${work}/archives")
file(MAKE_DIRECTORY "${stage}" "${archive_dir}")
message(STATUS "Release staging workspace: ${work}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config Release --prefix "${stage}"
    COMMAND_ERROR_IS_FATAL ANY)
foreach(file IN ITEMS README.md LICENSE third_party_versions.txt CMakeUserPresets.example.json)
    file(COPY "${repo}/${file}" DESTINATION "${stage}")
endforeach()
release_capture(documents "${git}" -C "${repo}" -c core.quotePath=false ls-files -- docs)
if(documents STREQUAL "")
    message(FATAL_ERROR "No tracked documentation to package")
endif()
string(REPLACE "\n" ";" documents "${documents}")
foreach(document IN LISTS documents)
    if(NOT document MATCHES "^docs/")
        message(FATAL_ERROR "Unexpected tracked documentation path: ${document}")
    endif()
    get_filename_component(dir "${document}" DIRECTORY)
    file(COPY "${repo}/${document}" DESTINATION "${stage}/${dir}")
endforeach()

set(package "Mosaicraft_v${version}_${platform}-${arch}_${RUNTIME}")
if(SMART_CROP)
    string(APPEND package "-smart-crop")
endif()
if(CHANNEL STREQUAL "candidate")
    string(APPEND package "_candidate")
endif()
if(platform STREQUAL "windows")
    set(generator ZIP)
    set(extension zip)
else()
    set(generator TGZ)
    set(extension tar.gz)
endif()
set(name "${package}.${extension}")
string(TIMESTAMP generated "%Y-%m-%dT%H:%M:%SZ" UTC)
foreach(backend IN ITEMS vulkan metal)
    set(${backend}_status disabled)
    if(${backend})
        set(${backend}_status enabled)
    endif()
endforeach()
set(info "Name: Mosaicraft\nVersion: ${version}\nPackage: ${name}\nPlatform: ${platform}\nArch: ${arch}\nRuntime: ${RUNTIME}\nVulkanBackend: ${vulkan_status}\nMetalBackend: ${metal_status}\nGpuValidation: ${gpu_validation}\nConfiguration: Release\nCommit: ${commit}\nGeneratedAtUtc: ${generated}\n")
if(SMART_CROP)
    string(APPEND info "SmartCrop: enabled\n")
endif()
if(SMART_CROP_CUDA)
    # Any later offline evidence belongs outside the ZIP because it binds to the final hash.
    string(APPEND info "SmartCropCuda: enabled\nSmartCropOfflineValidation: not-run\n")
endif()
if(SMART_CROP_VULKAN)
    string(APPEND info "SmartCropVulkan: enabled\nSmartCropCudaRuntime: cutlass\nSmartCropVulkanValidation: ${gpu_validation}\n")
endif()
string(JSON length LENGTH "${contracts}")
math(EXPR last "${length} - 1")
foreach(index RANGE 0 ${last})
    string(JSON key MEMBER "${contracts}" ${index})
    string(JSON value GET "${contracts}" "${key}")
    string(APPEND info "Internal.${key}: ${value}\n")
endforeach()
if(vulkan OR metal)
    set(auto disabled)
    if(vulkan_auto)
        set(auto vulkan-to-cpu)
    endif()
    string(APPEND info "PortableGpuValidation: not-run\nPortableAutoSelection: ${auto}\nPortableKernelVersion: portable-v1\nScoreModes: compatible;fast\nQualityDegradationLimit: 0.01\nFinalSelectionDifferenceLimit: 0.01\n")
endif()
if(cuda)
    foreach(key IN ITEMS CudaArchitectures CudaPtx CudaToolkit CudaRuntimeMode)
        release_field("${cuda_info}" "${key}" value)
        string(APPEND info "${key}: ${value}\n")
    endforeach()
    foreach(key IN ITEMS GpuValidationDevice GpuValidationComputeCapability GpuValidationDriver GpuValidationRuntime)
        if(gpu_validation STREQUAL "passed")
            release_field("${probe}" "${key}" value)
        else()
            set(value not-run)
        endif()
        string(APPEND info "${key}: ${value}\n")
    endforeach()
    release_cuda_metadata("${info}")
endif()
file(WRITE "${stage}/BUILD_INFO.txt" "${info}")

# Archive only the audited staging tree; rerunning the install from CPack would lose evidence.
file(CONFIGURE OUTPUT "${work}/CPackConfig.cmake" CONTENT [=[
set(CPACK_PACKAGE_NAME "Mosaicraft")
set(CPACK_PACKAGE_VERSION "@version@")
set(CPACK_PACKAGE_DESCRIPTION "Mosaicraft @version@ (@RUNTIME@)")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Mosaicraft @RUNTIME@")
set(CPACK_GENERATOR "@generator@")
set(CPACK_PACKAGE_FILE_NAME "@package@")
set(CPACK_PACKAGE_DIRECTORY "@archive_dir@")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_INSTALLED_DIRECTORIES "@stage@;.")
]=] @ONLY)
execute_process(COMMAND "${cpack}" --config "${work}/CPackConfig.cmake" COMMAND_ERROR_IS_FATAL ANY)
release_file("${archive_dir}/${name}")
file(SHA256 "${archive_dir}/${name}" sha)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${archive_dir}/${name}" "-DEXPECTED_SHA256=${sha}"
    "-DEXPECTED_COMMIT=${commit}" "-DEXPECTED_RUNTIME=${RUNTIME}" "-DEXPECTED_GPU_VALIDATION=${gpu_validation}"
    "-DEXPECTED_CHANNEL=${CHANNEL}"
    "-DEXPECTED_SMART_CROP=${SMART_CROP}"
    "-DSMART_CROP_FIXTURE_ROOT=${SMART_CROP_FIXTURE_ROOT}"
    "-DSMART_CROP_VERIFY_PYTHON=${SMART_CROP_VERIFY_PYTHON}"
    "-DCHECK_TOOL=${bin}/mosaicraft_release_check${suffix}" "-DWORK_ROOT=${work}" -DREQUIRE_CURRENT=ON
    -P "${CMAKE_CURRENT_LIST_DIR}/VerifyPackage.cmake" COMMAND_ERROR_IS_FATAL ANY)
release_capture(current "${git}" -C "${repo}" rev-parse HEAD)
release_capture(status "${git}" -C "${repo}" status --porcelain --untracked-files=normal)
if(NOT current STREQUAL commit OR NOT status STREQUAL "")
    message(FATAL_ERROR "The source changed during package creation; the archive was not promoted")
endif()
string(TOUPPER "${sha}" sha)
file(WRITE "${archive_dir}/${name}.sha256" "${sha}  ${name}\n")
file(RENAME "${archive_dir}/${name}" "${OUTPUT_DIR}/${name}")
file(RENAME "${archive_dir}/${name}.sha256" "${OUTPUT_DIR}/${name}.sha256")
message(STATUS "Package: ${OUTPUT_DIR}/${name}\nSHA256: ${sha}")
if(NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
    file(APPEND "$ENV{GITHUB_OUTPUT}" "archive-path=${OUTPUT_DIR}/${name}\n")
endif()
if(NOT KEEP_WORKSPACE)
    file(REMOVE_RECURSE "${work}")
endif()
