cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")

if(NOT TAG MATCHES "^v[0-9]+[.][0-9]+[.][0-9]+$")
    message(FATAL_ERROR "TAG must be a stable version such as v1.15.19")
endif()
if((DEFINED ARCHIVE_DIR AND DEFINED ASSETS_FILE) OR (NOT DEFINED ARCHIVE_DIR AND NOT DEFINED ASSETS_FILE))
    message(FATAL_ERROR "Specify exactly one of ARCHIVE_DIR or ASSETS_FILE")
endif()

file(READ "${CMAKE_CURRENT_LIST_DIR}/release-packages.json" matrix)
string(JSON package_count LENGTH "${matrix}" include)
if(NOT package_count EQUAL 6)
    message(FATAL_ERROR "The release matrix must define exactly six archives")
endif()
math(EXPR last "${package_count}-1")
set(expected)
foreach(index RANGE 0 ${last})
    foreach(key IN ITEMS platform suffix extension hostedCandidate)
        string(JSON ${key} GET "${matrix}" include ${index} ${key})
    endforeach()
    set(channel "")
    if(HOSTED AND hostedCandidate)
        set(channel _candidate)
    endif()
    set(name "Mosaicraft_${TAG}_${platform}_${suffix}${channel}.${extension}")
    if(name IN_LIST expected)
        message(FATAL_ERROR "Duplicate archive in release matrix: ${name}")
    endif()
    list(APPEND expected "${name}")
endforeach()
list(SORT expected)

if(DEFINED ARCHIVE_DIR)
    if(NOT IS_DIRECTORY "${ARCHIVE_DIR}")
        message(FATAL_ERROR "Archive directory missing: ${ARCHIVE_DIR}")
    endif()
    file(REAL_PATH "${ARCHIVE_DIR}" ARCHIVE_DIR)
    # A literal directory can contain characters that GLOB interprets as patterns.
    string(REGEX REPLACE "([?*]|\\[|\\])" "[\\1]" glob_dir "${ARCHIVE_DIR}")
    file(GLOB names LIST_DIRECTORIES FALSE RELATIVE "${ARCHIVE_DIR}" "${glob_dir}/*")
else()
    release_file("${ASSETS_FILE}")
    file(READ "${ASSETS_FILE}" assets)
    string(JSON asset_count LENGTH "${assets}" assets)
    set(names)
    if(asset_count GREATER 0)
        math(EXPR last "${asset_count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${assets}" assets ${index} name)
            string(REPLACE ";" "\\;" name "${name}")
            list(APPEND names "${name}")
        endforeach()
    endif()
endif()

set(missing "${expected}")
set(unexpected)
foreach(name IN LISTS names)
    if(name STREQUAL "SHA256SUMS.txt" OR name MATCHES "[.]sha256$")
        continue()
    endif()
    if(name IN_LIST expected)
        list(REMOVE_ITEM missing "${name}")
    else()
        list(APPEND unexpected "${name}")
    endif()
endforeach()
if(NOT "${missing}" STREQUAL "" OR NOT "${unexpected}" STREQUAL "")
    message(FATAL_ERROR "Missing archives: [${missing}]\nUnexpected archives: [${unexpected}]")
endif()

if(DEFINED ARCHIVE_DIR)
    set(sums "")
    foreach(name IN LISTS expected)
        set(archive "${ARCHIVE_DIR}/${name}")
        release_file("${archive}")
        release_file("${archive}.sha256")
        file(SHA256 "${archive}" digest)
        file(READ "${archive}.sha256" checksum)
        string(STRIP "${checksum}" checksum)
        string(REGEX MATCH "^[0-9a-fA-F]+" written_digest "${checksum}")
        string(TOLOWER "${written_digest}" normalized_digest)
        if(NOT normalized_digest STREQUAL digest OR NOT checksum STREQUAL "${written_digest}  ${name}")
            message(FATAL_ERROR "Checksum mismatch: ${name}")
        endif()
        string(APPEND sums "${digest}  ${name}\n")
    endforeach()
    # Write the sorted manifest only after all detached checksums have passed.
    file(WRITE "${ARCHIVE_DIR}/SHA256SUMS.txt" "${sums}")
endif()
message(STATUS "Verified ${package_count} release archives for ${TAG}")
