# Keep the manual nvcc commands and the package metadata on the same targets.
function(mosaicraft_cuda_architectures requested supported_codes supported_archs out_targets out_ptx out_flags)
    if("${requested}" STREQUAL "")
        message(FATAL_ERROR "CUDA_ARCH must contain at least one sm_XX target")
    endif()
    set(targets ${requested})
    list(REMOVE_DUPLICATES targets)
    list(SORT targets COMPARE NATURAL)
    set(flags)
    foreach(target IN LISTS targets)
        if(NOT target MATCHES "^sm_([0-9]+)$")
            message(FATAL_ERROR "Invalid CUDA_ARCH target: ${target}; expected sm_XX")
        endif()
        set(virtual "compute_${CMAKE_MATCH_1}")
        if(NOT target IN_LIST supported_codes OR NOT virtual IN_LIST supported_archs)
            message(FATAL_ERROR "CUDA_ARCH target ${target} is not supported by this nvcc")
        endif()
        list(APPEND flags "-gencode=arch=${virtual},code=${target}")
    endforeach()
    list(GET targets 0 lowest)
    string(REPLACE "sm_" "compute_" ptx "${lowest}")
    list(APPEND flags "-gencode=arch=${ptx},code=${ptx}")
    set(${out_targets} "${targets}" PARENT_SCOPE)
    set(${out_ptx} "${ptx}" PARENT_SCOPE)
    set(${out_flags} "${flags}" PARENT_SCOPE)
endfunction()
