cmake_minimum_required(VERSION 3.20)

function(embed_array input name type width columns)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR remainder "${length} % ${width}")
    if(length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "Empty or misaligned shader binary: ${input}")
    endif()

    set(array "inline constexpr ${type} ${name}[] =\n{\n")
    math(EXPR stride "${width} * ${columns}")
    foreach(offset RANGE 0 ${length} ${stride})
        if(offset EQUAL length)
            break()
        endif()
        string(SUBSTRING "${hex}" ${offset} ${stride} line)
        if(width EQUAL 8)
            # SPIR-V is stored little-endian; Vulkan consumes numeric words, not bytes.
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," line "${line}")
        else()
            string(REGEX REPLACE "(..)" "0x\\1," line "${line}")
        endif()
        string(APPEND array "    ${line}\n")
    endforeach()
    set(${name} "${array}};\n" PARENT_SCOPE)
endfunction()

if(FORMAT STREQUAL "spirv")
    embed_array("${FEATURES}" featureSpirv uint32_t 8 12)
    embed_array("${SCORING}" scoreSpirv uint32_t 8 12)
    set(includes "#include <cstdint>\n")
    set(arrays "${featureSpirv}${scoreSpirv}")
elseif(FORMAT STREQUAL "metal")
    embed_array("${INPUT}" metalLibrary "unsigned char" 2 24)
    set(arrays "${metalLibrary}")
else()
    message(FATAL_ERROR "FORMAT must be spirv or metal")
endif()
file(WRITE "${OUTPUT}" "#pragma once\n${includes}namespace mosaicraft::compute\n{\n${arrays}}\n")
