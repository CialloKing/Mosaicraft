function(desktop_devices cli compiled required available)
    release_capture(reply "${cli}" devices --json)
    string(JSON ok GET "${reply}" ok)
    if(NOT ok)
        message(FATAL_ERROR "The packaged CLI could not enumerate devices")
    endif()
    string(JSON devices GET "${reply}" data devices)
    string(JSON count LENGTH "${devices}")
    set(found)
    set(active)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON backend GET "${devices}" ${i} backend)
            string(JSON running GET "${devices}" ${i} available)
            string(JSON reason ERROR_VARIABLE missing GET "${devices}" ${i} reason)
            if(backend MATCHES "^(cuda|vulkan)$")
                if(NOT reason MATCHES "not compiled")
                    list(APPEND found "${backend}")
                endif()
                if(running)
                    list(APPEND active "${backend}")
                endif()
            endif()
        endforeach()
    endif()
    if(compiled AND (NOT "cuda" IN_LIST found OR NOT "vulkan" IN_LIST found))
        message(FATAL_ERROR "Desktop GPU bundle is missing a compiled backend")
    endif()
    if(required AND (NOT "cuda" IN_LIST active OR NOT "vulkan" IN_LIST active))
        message(FATAL_ERROR "A real CUDA device and a real Vulkan device are required")
    endif()
    set(${available} "${active}" PARENT_SCOPE)
endfunction()

function(desktop_preview worker_command dir request backend)
    set(preview "${dir}/preview-${backend}")
    file(MAKE_DIRECTORY "${preview}")
    string(JSON request SET "${request}" backend "\"${backend}\"")
    string(REPLACE "\n" "" request "${request}")
    set(input "${dir}/request.json")
    # The worker reads one JSON request from stdin. An input file avoids shell quoting.
    file(WRITE "${input}" "{\"op\":\"preview\",\"request\":${request},\"previewDirectory\":\"${preview}\"}\n")
    execute_process(COMMAND ${worker_command} INPUT_FILE "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE reply ERROR_VARIABLE error
        TIMEOUT 120)
    string(JSON ok ERROR_VARIABLE parse GET "${reply}" ok)
    string(JSON image ERROR_VARIABLE missing GET "${reply}" image)
    # Older tagged workers returned the preview inline and did not publish cells.bin.
    if(NOT status STREQUAL "0" OR parse OR NOT ok OR missing OR image STREQUAL "" OR
       (REQUIRE_STREAMED_PREVIEW AND NOT EXISTS "${preview}/cells.bin"))
        string(JSON reason ERROR_VARIABLE no_reason GET "${reply}" message)
        message(FATAL_ERROR "Packaged worker preview failed for ${backend} (${status}): ${reason}\n${error}")
    endif()
    message(STATUS "Packaged worker preview passed: ${backend}")
endfunction()

function(desktop_gpu_smoke bin suffix work required worker_command)
    set(cli "${bin}/mosaicraft${suffix}")
    file(TO_CMAKE_PATH "${work}/GPU smoke" dir)
    set(fixture "${dir}/input/target.png")
    set(library "${dir}/library")
    file(MAKE_DIRECTORY "${dir}/input")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/data/desktop-smoke.png" "${fixture}" COPYONLY)
    execute_process(COMMAND "${cli}" library build "${dir}/input" -o "${library}" --size 32x32 --backend cpu
        TIMEOUT 120 COMMAND_ERROR_IS_FATAL ANY)
    set(request "{\"inputPath\":\"${fixture}\",\"dbPath\":\"${library}\",\"outputPath\":\"${dir}/output.png\",\"outputMode\":\"image\",\"targetSize\":\"32x32\",\"tileW\":16,\"tileH\":16,\"seed\":9}")
    desktop_devices("${cli}" ON "${required}" active)
    if(required)
        desktop_preview("${worker_command}" "${dir}" "${request}" cuda)
        desktop_preview("${worker_command}" "${dir}" "${request}" vulkan)
    endif()
    set(ENV{CUDA_VISIBLE_DEVICES} -1)
    set(ENV{VK_DRIVER_FILES} "${dir}/no-driver.json")
    set(ENV{VK_ICD_FILENAMES} "${dir}/no-driver.json")
    desktop_devices("${cli}" ON OFF active)
    if(active)
        message(FATAL_ERROR "Both GPU backends must be hidden for CPU fallback validation")
    endif()
    desktop_preview("${worker_command}" "${dir}" "${request}" auto)
endfunction()
