# Used by model preparation, installation and the independent archive verifier.
function(smart_crop_verify_file path size sha256)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Missing locked smart crop file: ${path}")
    endif()
    file(SIZE "${path}" actual_size)
    file(SHA256 "${path}" actual_hash)
    if(NOT actual_size EQUAL size OR NOT actual_hash STREQUAL sha256)
        message(FATAL_ERROR "Size or SHA-256 mismatch for smart crop file: ${path}")
    endif()
endfunction()

function(smart_crop_verified_models lock dir result)
    set(files)
    foreach(index RANGE 0 2)
        string(JSON model GET "${lock}" models ${index})
        foreach(key IN ITEMS file size sha256)
            string(JSON ${key} GET "${model}" "${key}")
        endforeach()
        smart_crop_verify_file("${dir}/${file}" "${size}" "${sha256}")
        list(APPEND files "${dir}/${file}")
    endforeach()
    set(${result} "${files}" PARENT_SCOPE)
endfunction()

function(smart_crop_verified_vulkan_models lock dir result)
    set(files)
    foreach(model IN ITEMS saliency real anime)
        foreach(ext IN ITEMS param bin)
            string(JSON expected GET "${lock}" models ${model} ${ext})
            set(path "${dir}/${model}.${ext}")
            release_file("${path}")
            file(SHA256 "${path}" hash)
            if(IS_SYMLINK "${path}" OR NOT hash STREQUAL expected)
                message(FATAL_ERROR "Vulkan model SHA-256 mismatch: ${path}")
            endif()
            list(APPEND files "${path}")
        endforeach()
    endforeach()
    set(${result} "${files}" PARENT_SCOPE)
endfunction()

function(smart_crop_release_gate repo lock)
    string(JSON approval_type TYPE "${lock}" releaseApproval)
    if(NOT approval_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Smart crop release blocked: maintainer release approval is required")
    endif()
    string(JSON approval_status GET "${lock}" releaseApproval status)
    string(JSON approval_scope GET "${lock}" releaseApproval scope)
    string(JSON approval_approver GET "${lock}" releaseApproval approver)
    set(requested_scope "windows-x64-cuda-smart-crop")
    if(ARGC GREATER 2)
        set(requested_scope "${ARGV2}")
    endif()
    set(scopes "${approval_scope}")
    string(JSON extra ERROR_VARIABLE no_extra LENGTH "${lock}" releaseApproval additionalScopes)
    if(NOT no_extra AND extra GREATER 0)
        math(EXPR last "${extra} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON scope GET "${lock}" releaseApproval additionalScopes ${index})
            list(APPEND scopes "${scope}")
        endforeach()
    endif()
    if(NOT approval_status STREQUAL "approved-with-limitations" OR
       NOT requested_scope IN_LIST scopes OR approval_approver STREQUAL "")
        message(FATAL_ERROR "Smart crop release approval does not cover ${requested_scope}")
    endif()
    string(JSON accepted_count LENGTH "${lock}" releaseApproval acceptedUnverifiedModelRights)
    foreach(index RANGE 0 2)
        string(JSON model GET "${lock}" models ${index})
        string(JSON id GET "${model}" id)
        string(JSON approved GET "${model}" redistributionVerified)
        string(JSON notice GET "${model}" notice)
        if(notice STREQUAL "" OR NOT EXISTS "${repo}/third_party/model-notices/${notice}")
            message(FATAL_ERROR "Smart crop release blocked: missing model notice for ${id}")
        endif()
        if(NOT approved)
            set(accepted FALSE)
            math(EXPR accepted_last "${accepted_count}-1")
            foreach(approval_index RANGE 0 ${accepted_last})
                string(JSON accepted_id GET "${lock}" releaseApproval acceptedUnverifiedModelRights ${approval_index})
                if(accepted_id STREQUAL id)
                    set(accepted TRUE)
                endif()
            endforeach()
            if(NOT accepted)
                message(FATAL_ERROR "Smart crop release blocked: no explicit maintainer acceptance for ${id}")
            endif()
        endif()
    endforeach()
    string(JSON review_type TYPE "${lock}" qualityReview)
    if(NOT review_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Smart crop release blocked: preliminary review is required")
    endif()
    string(JSON review GET "${lock}" qualityReview)
    foreach(key IN ITEMS file size sha256)
        string(JSON ${key} GET "${review}" "${key}")
    endforeach()
    string(JSON review_status GET "${review}" status)
    if(NOT file MATCHES "^docs/verification/[a-z0-9-]+[.]md$")
        message(FATAL_ERROR "Invalid smart crop quality review path: ${file}")
    endif()
    if(NOT review_status STREQUAL "preliminary-approved")
        message(FATAL_ERROR "Smart crop quality review is not approved for preliminary release")
    endif()
    smart_crop_verify_file("${repo}/${file}" "${size}" "${sha256}")
endfunction()

function(smart_crop_verify_fixtures fixture_root lock)
    if(NOT IS_ABSOLUTE "${fixture_root}" OR NOT IS_DIRECTORY "${fixture_root}")
        message(FATAL_ERROR "SMART_CROP_FIXTURE_ROOT must point to an absolute directory for annotated verification")
    endif()
    string(JSON count LENGTH "${lock}" fixtures)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Annotated verification expects one locked real and one locked anime fixture")
    endif()
    foreach(index RANGE 0 1)
        string(JSON fixture GET "${lock}" fixtures ${index})
        foreach(key IN ITEMS mode file size sha256)
            string(JSON ${key} GET "${fixture}" "${key}")
        endforeach()
        if((index EQUAL 0 AND NOT mode STREQUAL "smart-real") OR
           (index EQUAL 1 AND NOT mode STREQUAL "smart-anime") OR
           NOT file MATCHES "^(real|anime)/input/positive[.]png$")
            message(FATAL_ERROR "Unexpected smart crop fixture: ${mode}/${file}")
        endif()
        string(JSON face_length LENGTH "${fixture}" mainFace)
        if(NOT face_length EQUAL 4)
            message(FATAL_ERROR "Expected four annotated face coordinates: ${file}")
        endif()
        foreach(coord RANGE 0 3)
            string(JSON value GET "${fixture}" mainFace ${coord})
            if(NOT value MATCHES "^[0-9]+$")
                message(FATAL_ERROR "Invalid annotated face coordinate: ${file}")
            endif()
        endforeach()
        smart_crop_verify_file("${fixture_root}/${file}" "${size}" "${sha256}")
    endforeach()
endfunction()

function(smart_crop_smoke cli work fixture mode device verifier python)
    file(MAKE_DIRECTORY "${work}/input" "${work}/outside")
    get_filename_component(extension "${fixture}" LAST_EXT)
    configure_file("${fixture}" "${work}/input/probe${extension}" COPYONLY)
    set(command "${cli}" library normalize "${work}/input" --size 180x320 --threads 1 --json)
    execute_process(COMMAND ${command} -o "${work}/smart" --crop "${mode}" --crop-device "${device}"
        WORKING_DIRECTORY "${work}/outside" TIMEOUT 60 COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE reply)
    string(SUBSTRING "${device}" 0 1 initial)
    string(TOUPPER "${initial}" initial)
    string(SUBSTRING "${device}" 1 -1 tail)
    string(JSON runtime_device GET "${reply}" runtime device)
    string(JSON device_count GET "${reply}" runtime metrics "smartCrop${initial}${tail}Images")
    if(NOT runtime_device STREQUAL device OR NOT device_count EQUAL 1)
        message(FATAL_ERROR "Archive smart crop did not execute ${mode} on ${device}")
    endif()
    set(output "${work}/smart/0${extension}")
    # Standalone normalization preserves BMP for the generated input and PNG for annotated inputs.
    if(extension STREQUAL ".bmp")
        file(READ "${output}" signature LIMIT 2 HEX)
        file(READ "${output}" dimensions OFFSET 18 LIMIT 8 HEX)
        set(header "${signature}${dimensions}")
        set(expected_header "424db400000040010000")
    else()
        file(READ "${output}" header LIMIT 24 HEX)
        set(expected_header "89504e470d0a1a0a0000000d49484452000000b400000140")
    endif()
    if(NOT header STREQUAL expected_header)
        message(FATAL_ERROR "Archive smart crop produced an invalid 180 x 320 image for ${mode} on ${device}")
    endif()
    if(verifier)
        foreach(pair IN ITEMS "smartCropFacesFound;1" "smartCropMoved;1" "smartCropMainFaceClipped;0")
            list(GET pair 0 key)
            list(GET pair 1 expected)
            string(JSON value GET "${reply}" runtime metrics "${key}")
            if(NOT value EQUAL expected)
                message(FATAL_ERROR "Archive smart crop smoke failed (${mode}): ${key}=${value}, expected ${expected}")
            endif()
        endforeach()
        execute_process(COMMAND ${command} -o "${work}/center" WORKING_DIRECTORY "${work}/outside"
            TIMEOUT 60 COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
        execute_process(COMMAND "${python}" "${verifier}" "${fixture}" "${work}/center/0.png" "${output}" ${ARGN}
            WORKING_DIRECTORY "${work}/outside" TIMEOUT 30 COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

# The release builder and independent verifier use the same file allowlist.
function(smart_crop_cuda_redist repo root dlls notices)
    set(lock "${repo}/cmake/smart-crop-cuda-redist-windows.json")
    if(NOT EXISTS "${lock}")
        message(FATAL_ERROR "CUDA smart crop bundling requires the approved Windows NVIDIA runtime lock")
    endif()
    file(READ "${lock}" manifest)
    foreach(key IN ITEMS files notices)
        string(JSON count LENGTH "${manifest}" "${key}")
        if(count LESS 1)
            message(FATAL_ERROR "Empty CUDA smart crop runtime lock section: ${key}")
        endif()
        math(EXPR last "${count}-1")
        foreach(i RANGE 0 ${last})
            foreach(field IN ITEMS file size sha256)
                string(JSON ${field} GET "${manifest}" "${key}" "${i}" "${field}")
            endforeach()
            if(key STREQUAL "files")
                string(TOLOWER "${file}" name)
                if(NOT name MATCHES "^(cu(blas|dnn|dart|fft|rand|solver|sparse|pti)|nv(rtc|jitlink|fatbin))[a-z0-9_]*[.]dll$" OR
                   name IN_LIST approved_names)
                    message(FATAL_ERROR "Unexpected NVIDIA runtime filename in smart crop lock: ${file}")
                endif()
                set(path "${root}/${file}")
                list(APPEND approved_names "${name}")
                list(APPEND approved_dlls "${path}")
            else()
                if(NOT file MATCHES "^[a-z0-9_-]+[.]txt$")
                    message(FATAL_ERROR "Unexpected NVIDIA notice filename: ${file}")
                endif()
                set(path "${root}/licenses/cuda-smart-crop/${file}")
                list(APPEND approved_notices "${path}")
            endif()
            smart_crop_verify_file("${path}" "${size}" "${sha256}")
        endforeach()
    endforeach()
    if(NOT "cudnn64_9.dll" IN_LIST approved_names)
        message(FATAL_ERROR "The runtime lock must include the pinned cuDNN runtime")
    endif()
    file(GLOB actual RELATIVE "${root}" "${root}/*.dll")
    foreach(dll IN LISTS actual)
        string(TOLOWER "${dll}" name)
        if(name MATCHES "^(cu(blas|dnn|dart|fft|rand|solver|sparse|pti)|nv)[a-z0-9_]*[.]dll$" AND
           NOT name IN_LIST approved_names)
            message(FATAL_ERROR "Unapproved NVIDIA runtime in smart crop bundle: ${dll}")
        endif()
    endforeach()
    set(${dlls} "${approved_dlls}" PARENT_SCOPE)
    set(${notices} "${approved_notices}" PARENT_SCOPE)
endfunction()

function(smart_crop_verify_offline_evidence evidence commit sha)
    if(NOT IS_ABSOLUTE "${evidence}" OR NOT EXISTS "${evidence}")
        message(FATAL_ERROR "Provide SMART_CROP_CUDA_OFFLINE_EVIDENCE from independent Windows GPU ZIP acceptance")
    endif()
    file(READ "${evidence}" report)
    foreach(key IN ITEMS commit sha256 platform gpu driver)
        string(JSON ${key}_actual GET "${report}" "${key}")
        if("${${key}_actual}" STREQUAL "")
            message(FATAL_ERROR "Incomplete CUDA smart crop offline evidence: ${key}")
        endif()
    endforeach()
    string(TOLOWER "${sha256_actual}" sha256_actual)
    string(TOLOWER "${sha}" sha)
    if(NOT commit_actual STREQUAL commit OR NOT sha256_actual STREQUAL sha OR NOT platform_actual STREQUAL "windows-x64")
        message(FATAL_ERROR "CUDA smart crop offline record does not describe this ZIP and commit")
    endif()
    foreach(key IN ITEMS offline noToolkit noCudnn cliReal cliAnime webReal webAnime)
        string(JSON kind TYPE "${report}" "${key}")
        string(JSON passed GET "${report}" "${key}")
        if(NOT kind STREQUAL "BOOLEAN" OR NOT passed)
            message(FATAL_ERROR "CUDA smart crop offline evidence did not pass: ${key}")
        endif()
    endforeach()
endfunction()
