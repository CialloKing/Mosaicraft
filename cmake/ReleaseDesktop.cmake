cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseChecks.cmake")
release_host(platform arch exe)
set(target "${platform}-${arch}")
if(NOT DEFINED SOURCE_DIR)
    set(SOURCE_DIR "${MOSAICRAFT_REPO}")
endif()
file(REAL_PATH "${SOURCE_DIR}" repo)
find_program(git git REQUIRED)
release_capture(status "${git}" -C "${repo}" status --porcelain --untracked-files=normal)
release_capture(commit "${git}" -C "${repo}" rev-parse HEAD)
if(NOT status STREQUAL "" OR (DEFINED EXPECTED_COMMIT AND NOT commit STREQUAL EXPECTED_COMMIT))
    message(FATAL_ERROR "Desktop release requires the expected clean source commit")
endif()
file(READ "${repo}/contracts.json" contracts)
string(JSON version GET "${contracts}" softwareVersion)
if((DEFINED SOURCE_TAG AND NOT SOURCE_TAG STREQUAL "v${version}") OR
   ("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag" AND NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "v${version}"))
    message(FATAL_ERROR "Desktop release tag does not match contracts.json")
endif()
if(DEFINED SOURCE_TAG)
    release_capture(tag_commit "${git}" -C "${repo}" rev-parse "refs/tags/${SOURCE_TAG}^{commit}")
    if(NOT tag_commit STREQUAL commit)
        message(FATAL_ERROR "Desktop source does not match ${SOURCE_TAG}")
    endif()
endif()
if(NOT DEFINED RUNTIME)
    set(RUNTIME cpu-only)
endif()
if(NOT RUNTIME MATCHES "^(cpu-only|cuda-vulkan)$")
    message(FATAL_ERROR "Desktop RUNTIME must be cpu-only or cuda-vulkan")
endif()
set(gpu OFF)
set(suffix qt)
set(extension tar.gz)
set(archive_args czf --format=gnutar)
if(platform STREQUAL "windows")
    set(extension zip)
    set(archive_args cf --format=zip)
endif()
if(RUNTIME STREQUAL "cuda-vulkan")
    set(gpu ON)
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "CUDA + Vulkan desktop packages require Windows or Linux x64")
    endif()
    if(NOT DEFINED GPU_VALIDATION)
        set(GPU_VALIDATION Required)
    endif()
    if(NOT GPU_VALIDATION MATCHES "^(Required|BuildOnly)$")
        message(FATAL_ERROR "GPU_VALIDATION must be Required or BuildOnly")
    endif()
    set(suffix qt_cuda-vulkan)
    if(platform STREQUAL "windows" AND GPU_VALIDATION STREQUAL "BuildOnly")
        string(APPEND suffix _candidate)
    endif()
endif()
foreach(key IN ITEMS QT_ROOT VCPKG_ROOT)
    if(NOT DEFINED ${key})
        if(key STREQUAL "QT_ROOT")
            set(${key} "$ENV{MOSAICRAFT_QT_ROOT}")
        else()
            set(${key} "$ENV{VCPKG_ROOT}")
        endif()
    endif()
    cmake_path(ABSOLUTE_PATH ${key} BASE_DIRECTORY "${repo}" NORMALIZE)
endforeach()
release_file("${QT_ROOT}/lib/cmake/Qt6/Qt6Config.cmake")
release_file("${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
set(ENV{VCPKG_ROOT} "${VCPKG_ROOT}")
file(READ "${repo}/cmake/qt-sdk.json" qt_lock)
string(JSON qt_version GET "${qt_lock}" version)
file(READ "${repo}/vcpkg.json" manifest)
string(JSON baseline GET "${manifest}" builtin-baseline)
release_capture(head "${git}" -C "${VCPKG_ROOT}" rev-parse HEAD)
if(NOT head STREQUAL baseline)
    message(FATAL_ERROR "Desktop releases require the source tag's locked vcpkg checkout: ${baseline}")
endif()
if(platform STREQUAL "macos")
    set(triplet arm64-osx-release)
else()
    set(triplet "${arch}-${platform}-release")
endif()
if(NOT DEFINED VCPKG_INSTALLED_DIR)
    set(VCPKG_INSTALLED_DIR "$ENV{MOSAICRAFT_VCPKG_INSTALLED_DIR}")
    if(VCPKG_INSTALLED_DIR STREQUAL "")
        set(VCPKG_INSTALLED_DIR third_party/vcpkg_installed)
    endif()
endif()
cmake_path(ABSOLUTE_PATH VCPKG_INSTALLED_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
if(NOT IS_DIRECTORY "${VCPKG_INSTALLED_DIR}/${triplet}")
    message(FATAL_ERROR "Install the locked ${triplet} dependencies first")
endif()
if(NOT DEFINED BUILD_DIR)
    set(BUILD_DIR "build/package-qt-${suffix}")
endif()
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR build/archives-qt)
endif()
cmake_path(ABSOLUTE_PATH BUILD_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR BASE_DIRECTORY "${repo}" NORMALIZE)
set(native "${BUILD_DIR}/native")
set(gui "${BUILD_DIR}/gui")
set(bin "${native}/Release/bin")
set(preset "${target}")
file(READ "${repo}/CMakePresets.json" presets)
# Supplemental releases can use the older preset names in the source tag.
if(NOT presets MATCHES "\"name\"[ \t\r\n]*:[ \t\r\n]*\"${preset}\"")
    if(platform STREQUAL "macos")
        set(preset macos-arm64-cpu)
    elseif(gpu)
        set(preset "${platform}-cuda")
    else()
        set(preset "${platform}-cpu")
    endif()
endif()
set(sdk_args)
set(targets mosaicraft mosaicraft_desktop_worker)
if(gpu)
    string(REPLACE ";" "\;" architectures "${MOSAICRAFT_NATIVE}")
    list(APPEND sdk_args "-DCUDA_ARCH:STRING=${architectures}")
    foreach(key IN ITEMS CUDAToolkit_ROOT MOSAICRAFT_VULKAN_INCLUDE MOSAICRAFT_GLSLANG)
        if(DEFINED ${key})
            list(APPEND sdk_args "-D${key}=${${key}}")
        endif()
    endforeach()
    list(APPEND targets mosaicraft_tests)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --preset "${preset}" -S "${repo}" -B "${native}"
    "-DCMAKE_TOOLCHAIN_FILE=${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake" "-DVCPKG_INSTALLED_DIR=${VCPKG_INSTALLED_DIR}"
    "-DVCPKG_OVERLAY_TRIPLETS=${repo}/cmake/triplets" "-DVCPKG_TARGET_TRIPLET=${triplet}" "-DVCPKG_HOST_TRIPLET=${triplet}"
    -DVCPKG_MANIFEST_INSTALL=OFF -DMOSAICRAFT_BUNDLE_RUNTIME=ON -DMOSAICRAFT_DESKTOP_BACKEND_INSTALL=ON -DMOSAICRAFT_SMART_CROP=OFF
    -DMOSAICRAFT_BUILD_DESKTOP=OFF "-DMOSAICRAFT_CUDA:BOOL=${gpu}" "-DMOSAICRAFT_VULKAN:BOOL=${gpu}"
    -DMOSAICRAFT_VULKAN_AUTO:BOOL=OFF -DMOSAICRAFT_METAL:BOOL=OFF ${sdk_args} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${native}" --config Release --target ${targets} COMMAND_ERROR_IS_FATAL ANY)
set(info "Version: ${version}\nGitCommit: ${commit}\nPlatform: ${target}\nRuntime: ${RUNTIME}\nQtVersion: ${qt_version}\n")
set(smoke_args)
if(gpu)
    release_inspect_cuda("${native}" "${exe}" "${platform}" "${repo}/cmake/cuda-13.5.json"
        images mosaicraft mosaicraft_desktop_worker)
    set(state not-run)
    list(APPEND smoke_args -DRUN_SMOKE=ON)
    if(EXISTS "${repo}/src/desktop_worker.cpp")
        list(APPEND smoke_args -DREQUIRE_STREAMED_PREVIEW=ON)
    endif()
    set(ENV{MOSAICRAFT_REQUIRE_CUDA} 0)
    if(GPU_VALIDATION STREQUAL "Required")
        release_capture(probe "${bin}/mosaicraft_tests${exe}" --require-cuda)
        if(NOT probe MATCHES "(^|\n)GPU validation passed(\r?\n|$)")
            message(FATAL_ERROR "CUDA kernel probe did not pass: ${probe}")
        endif()
        set(state passed)
        list(APPEND smoke_args -DREQUIRE_GPU=ON)
        set(ENV{MOSAICRAFT_REQUIRE_CUDA} 1)
        foreach(key IN ITEMS GpuValidationDevice GpuValidationComputeCapability GpuValidationDriver GpuValidationRuntime)
            release_field("${probe}" "${key}" value)
            string(APPEND info "${key}: ${value}\n")
        endforeach()
    endif()
    get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
    find_program(ctest ctest PATHS "${cmake_bin}" NO_DEFAULT_PATH REQUIRED)
    execute_process(COMMAND "${ctest}" --test-dir "${native}" -C Release -R "^mosaicraft_tests$"
        --no-tests=error --output-on-failure COMMAND_ERROR_IS_FATAL ANY)
    string(APPEND info "GpuValidation: ${state}\nPortableGpuValidation: ${state}\nPortableAutoSelection: cuda-to-cpu\nCudaBackend: enabled\nVulkanBackend: enabled\n")
    foreach(key IN ITEMS CudaToolkit CudaRuntimeMode CudaArchitectures CudaPtx)
        release_field("${images}" "${key}" value)
        string(APPEND info "${key}: ${value}\n")
    endforeach()
endif()
set(generator -G Ninja)
if(platform STREQUAL "windows")
    set(generator -G "Visual Studio 18 2026" -A x64)
elseif(platform STREQUAL "macos")
    list(APPEND generator -DCMAKE_OSX_ARCHITECTURES=arm64)
else()
    list(APPEND generator "-DCMAKE_INSTALL_RPATH=$ORIGIN/../lib")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${repo}/desktop" -B "${gui}" ${generator}
    -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${QT_ROOT}" -DMOSAICRAFT_DEPLOY_QT=ON
    -DCMAKE_INSTALL_BINDIR=bin -DCMAKE_INSTALL_LIBDIR=lib "-DMOSAICRAFT_QT_RELEASE_VERSION=${qt_version}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${gui}" --config Release COMMAND_ERROR_IS_FATAL ANY)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${OUTPUT_DIR}/.mosaicraft-${nonce}")
set(stem "Mosaicraft_v${version}_${target}_${suffix}")
set(package "${work}/${stem}")
set(name "${stem}.${extension}")
file(MAKE_DIRECTORY "${work}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${gui}" --config Release --prefix "${package}" COMMAND_ERROR_IS_FATAL ANY)
set(backend "${package}/bin")
if(platform STREQUAL "macos")
    set(app "${package}/MosaicraftDesktop.app")
    set(backend "${app}/Contents/MacOS")
endif()
# Installing the relocated backend changes the macOS app signature.
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${native}" --config Release --prefix "${backend}" COMMAND_ERROR_IS_FATAL ANY)
if(platform STREQUAL "macos")
    execute_process(COMMAND codesign --force --deep --sign - "${app}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --verify --deep --strict "${app}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(COPY "${repo}/LICENSE" DESTINATION "${package}")
file(READ "${repo}/docs/development/desktop-redistribution.txt" notice)
string(REPLACE "@QT_VERSION@" "${qt_version}" notice "${notice}")
if(gpu)
    string(REPLACE "Desktop (CPU)" "Desktop (CUDA + Vulkan)" notice "${notice}")
    string(APPEND notice "\nAuto uses CUDA when available, otherwise CPU. Select Vulkan explicitly.\nInstall the host driver for the GPU backend you intend to use.\n")
endif()
file(WRITE "${package}/desktop-redistribution.txt" "${notice}")
set(notices "${package}/licenses/qt")
file(COPY "${repo}/third_party/qt-notices/LGPL-3.0-only.txt" DESTINATION "${notices}")
if(platform STREQUAL "linux")
    file(COPY "${repo}/third_party/qt-notices/ICU-73.2.txt" DESTINATION "${notices}")
endif()
foreach(module IN ITEMS qtbase qtimageformats qttranslations)
    file(COPY "${QT_ROOT}/sbom/${module}-${qt_version}.cdx.json" DESTINATION "${notices}")
endforeach()
file(WRITE "${package}/BUILD_INFO.txt" "${info}")
list(POP_FRONT archive_args mode)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar "${mode}" "${work}/${name}" ${archive_args} -- "${stem}"
    WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${work}/${name}" sha)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${work}/${name}" "-DEXPECTED_SHA256=${sha}"
    "-DEXPECTED_COMMIT=${commit}" ${smoke_args} -P "${CMAKE_CURRENT_LIST_DIR}/VerifyDesktopPackage.cmake" COMMAND_ERROR_IS_FATAL ANY)
release_capture(status "${git}" -C "${repo}" status --porcelain --untracked-files=normal)
release_capture(current "${git}" -C "${repo}" rev-parse HEAD)
if(NOT status STREQUAL "" OR NOT current STREQUAL commit)
    message(FATAL_ERROR "The source changed during desktop packaging; the archive was not promoted")
endif()
file(WRITE "${work}/${name}.sha256" "${sha}  ${name}\n")
file(RENAME "${work}/${name}" "${OUTPUT_DIR}/${name}")
file(RENAME "${work}/${name}.sha256" "${OUTPUT_DIR}/${name}.sha256")
if(NOT KEEP_WORKSPACE)
    file(REMOVE_RECURSE "${work}")
endif()
message(STATUS "Verified desktop package: ${OUTPUT_DIR}/${name}")
