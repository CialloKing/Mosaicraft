function(export_variable name value)
    set(ENV{${name}} "${value}")
    if(NOT "$ENV{GITHUB_ENV}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_ENV}" "${name}=${value}\n")
    endif()
endfunction()

function(locked_download url path hash)
    string(TOLOWER "${hash}" hash)
    if(EXISTS "${path}")
        file(SHA256 "${path}" actual)
        if(actual STREQUAL hash)
            return()
        endif()
    endif()
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(temp "${path}.${nonce}.download")
    foreach(attempt RANGE 1 3)
        file(DOWNLOAD "${url}" "${temp}" TLS_VERIFY ON TIMEOUT 1800 INACTIVITY_TIMEOUT 45 STATUS status)
        list(GET status 0 code)
        if(code EQUAL 0)
            file(SHA256 "${temp}" actual)
            if(NOT actual STREQUAL hash)
                message(FATAL_ERROR "Download failed SHA-256 validation: ${url}")
            endif()
            file(RENAME "${temp}" "${path}")
            return()
        endif()
        if(attempt LESS 3)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
        endif()
    endforeach()
    message(FATAL_ERROR "Could not download ${url}: ${status}")
endfunction()

if(MODE MATCHES "^(Models|SmartCropGate)$")
    include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
    file(READ "${repo}/cmake/smart-crop-models.json" lock)
    if(MODE STREQUAL "SmartCropGate")
        if(DEFINED SMART_CROP_SCOPE)
            smart_crop_release_gate("${repo}" "${lock}" "${SMART_CROP_SCOPE}")
        else()
            smart_crop_release_gate("${repo}" "${lock}")
        endif()
        return()
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/smart-crop-models/prepared")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    file(MAKE_DIRECTORY "${DESTINATION}")
    string(JSON count LENGTH "${lock}" models)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON model GET "${lock}" models ${index})
        foreach(key IN ITEMS file size sha256 url)
            string(JSON ${key} GET "${model}" "${key}")
        endforeach()
        set(output "${DESTINATION}/${file}")
        locked_download("${url}" "${output}" "${sha256}")
        smart_crop_verify_file("${output}" "${size}" "${sha256}")
    endforeach()
    message(STATUS "Verified smart crop models: ${DESTINATION}")
    return()
endif()

if(MODE STREQUAL "SmartCropCudaRedist")
    if(NOT platform STREQUAL "windows" OR NOT arch STREQUAL "x64")
        message(FATAL_ERROR "Smart crop CUDA runtime preparation is Windows x64 only")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/smart-crop-cuda-redist")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    file(MAKE_DIRECTORY "${DESTINATION}/licenses/cuda-smart-crop")
    file(READ "${repo}/cmake/smart-crop-cuda-redist-windows.json" manifest)
    file(READ "${repo}/cmake/cudnn-9.28.1.json" cudnn_lock)
    string(JSON cublas GET "${manifest}" cublas)
    string(JSON cudnn GET "${cudnn_lock}" platforms windows-x86_64)
    foreach(component IN ITEMS cublas cudnn)
        foreach(key IN ITEMS relative_path size sha256)
            string(JSON ${key} GET "${${component}}" ${key})
        endforeach()
        set(kind cuda)
        if(component STREQUAL "cudnn")
            set(kind cudnn)
        endif()
        set(downloads "${repo}/build/${kind}-downloads")
        file(MAKE_DIRECTORY "${downloads}")
        get_filename_component(archive_name "${relative_path}" NAME)
        get_filename_component(archive_root "${archive_name}" NAME_WLE)
        set(archive "${downloads}/${archive_name}")
        locked_download("https://developer.download.nvidia.com/compute/${kind}/redist/${relative_path}" "${archive}" "${sha256}")
        smart_crop_verify_file("${archive}" "${size}" "${sha256}")

        # Extract only the locked inputs, not a second SDK or unused runtime DLLs.
        set(members "${archive_root}/LICENSE")
        set(dlls)
        string(JSON count LENGTH "${manifest}" files)
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON owner GET "${manifest}" files ${i} component)
            if(owner STREQUAL component)
                string(JSON file GET "${manifest}" files ${i} file)
                list(APPEND dlls "${file}")
                list(APPEND members "${archive_root}/bin/x64/${file}")
            endif()
        endforeach()
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
        set(extract "${DESTINATION}/extract-${nonce}")
        file(MAKE_DIRECTORY "${extract}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}" PATTERNS ${members})
        foreach(file IN LISTS dlls)
            file(RENAME "${extract}/${archive_root}/bin/x64/${file}" "${DESTINATION}/${file}")
        endforeach()
        file(RENAME "${extract}/${archive_root}/LICENSE" "${DESTINATION}/licenses/cuda-smart-crop/${component}.txt")
        # Only remove the just-created scratch tree under the resolved destination.
        file(REAL_PATH "${DESTINATION}" redist_root)
        file(REAL_PATH "${extract}" extract_root)
        cmake_path(IS_PREFIX redist_root "${extract_root}" NORMALIZE extract_is_local)
        if(extract_is_local AND NOT extract_root STREQUAL redist_root)
            file(REMOVE_RECURSE "${extract_root}")
        endif()
    endforeach()
    smart_crop_cuda_redist("${repo}" "${DESTINATION}" verified_dlls verified_notices)
    message(STATUS "Verified Windows smart crop CUDA runtime files: ${DESTINATION}")
    return()
endif()

if(MODE STREQUAL "CuDNN")
    if(NOT platform MATCHES "^(windows|linux)$" OR NOT arch STREQUAL "x64")
        message(FATAL_ERROR "cuDNN preparation supports Windows and Linux x64 only")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/cudnn-9.28.1.4")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    file(READ "${repo}/cmake/cudnn-9.28.1.json" lock)
    string(JSON entry GET "${lock}" platforms "${platform}-x86_64")
    foreach(key IN ITEMS relative_path sha256 size)
        string(JSON ${key} GET "${entry}" "${key}")
    endforeach()
    set(downloads "${repo}/build/cudnn-downloads")
    file(MAKE_DIRECTORY "${downloads}")
    get_filename_component(name "${relative_path}" NAME)
    set(archive "${downloads}/${name}")
    locked_download("https://developer.download.nvidia.com/compute/cudnn/redist/${relative_path}" "${archive}" "${sha256}")
    file(SIZE "${archive}" actual_size)
    if(NOT actual_size EQUAL size)
        message(FATAL_ERROR "Locked cuDNN archive size mismatch")
    endif()
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(extract "${downloads}/extract-${nonce}")
    file(MAKE_DIRECTORY "${extract}" "${DESTINATION}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
    file(GLOB roots "${extract}/*")
    list(LENGTH roots count)
    if(NOT count EQUAL 1 OR NOT IS_DIRECTORY "${roots}/include" OR NOT IS_DIRECTORY "${roots}/lib")
        message(FATAL_ERROR "Unexpected cuDNN archive layout")
    endif()
    # Keep the extracted SDK intact; only audited runtime files may enter a release.
    foreach(dir IN ITEMS include lib bin)
        if(IS_DIRECTORY "${roots}/${dir}")
            file(RENAME "${roots}/${dir}" "${DESTINATION}/${dir}" RESULT moved)
            if(NOT moved STREQUAL "0")
                message(FATAL_ERROR "Install into a new cuDNN SDK directory: ${moved}")
            endif()
        endif()
    endforeach()
    file(GLOB notices "${roots}/LICENSE*")
    foreach(notice IN LISTS notices)
        file(COPY "${notice}" DESTINATION "${DESTINATION}")
    endforeach()
    file(WRITE "${DESTINATION}/archive.sha256" "${sha256}\n")
    export_variable(MOSAICRAFT_CUDNN_SDK "${DESTINATION}")
    message(STATUS "Locked cuDNN SDK: ${DESTINATION}")
    return()
endif()

if(MODE STREQUAL "CUDA")
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "CUDA preparation supports Windows and Linux x64 only")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/cuda-13.5")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    set(downloads "${repo}/build/cuda-downloads")
    file(MAKE_DIRECTORY "${DESTINATION}/licenses" "${downloads}")
    file(READ "${repo}/cmake/cuda-13.5.json" lock)
    string(JSON length LENGTH "${lock}" components)
    math(EXPR last "${length} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON component MEMBER "${lock}" components ${index})
        string(JSON entry GET "${lock}" components "${component}" "${platform}-x86_64")
        string(JSON relative GET "${entry}" relative_path)
        string(JSON hash GET "${entry}" sha256)
        get_filename_component(name "${relative}" NAME)
        set(archive "${downloads}/${name}")
        locked_download("https://developer.download.nvidia.com/compute/cuda/redist/${relative}" "${archive}" "${hash}")
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
        set(extract "${downloads}/extract-${nonce}")
        file(MAKE_DIRECTORY "${extract}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
        file(GLOB roots "${extract}/*")
        list(LENGTH roots count)
        if(NOT count EQUAL 1 OR NOT IS_DIRECTORY "${roots}")
            message(FATAL_ERROR "Unexpected CUDA component archive layout: ${archive}")
        endif()
        # Redist archives use LICENSE or LICENSE.txt. Keep each component's terms before merging roots.
        set(license "${roots}/LICENSE")
        if(NOT EXISTS "${license}")
            set(license "${roots}/LICENSE.txt")
        endif()
        release_file("${license}")
        file(COPY_FILE "${license}" "${DESTINATION}/licenses/${component}.txt")
        file(COPY "${roots}/" DESTINATION "${DESTINATION}" USE_SOURCE_PERMISSIONS)
        file(REMOVE_RECURSE "${extract}")
    endforeach()
    string(JSON version GET "${lock}" components cuda_nvcc version)
    string(REPLACE "." "\\." pattern "${version}")
    release_capture(actual "${DESTINATION}/bin/nvcc${suffix}" --version)
    if(NOT actual MATCHES "V${pattern}([^0-9]|$)")
        message(FATAL_ERROR "Unexpected nvcc version: ${actual}")
    endif()
    export_variable(CUDA_PATH "${DESTINATION}")
    export_variable(CUDAToolkit_ROOT "${DESTINATION}")
    export_variable(MOSAICRAFT_CUDA_SDK "${DESTINATION}")
    if(NOT "$ENV{GITHUB_PATH}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_PATH}" "${DESTINATION}/bin\n")
    endif()
    message(STATUS "CUDA ${version}: ${DESTINATION}")
    return()
elseif(MODE STREQUAL "Vulkan")
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "Use Metal on macOS")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/vulkan")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    set(headers "${DESTINATION}/Vulkan-Headers")
    set(revision b379292b2ab6df5771ba9870d53cf8b2c9295daf)
    file(MAKE_DIRECTORY "${DESTINATION}")
    if(NOT EXISTS "${headers}/.git")
        execute_process(COMMAND "${git}" clone --depth 1 --branch v1.3.290
            https://github.com/KhronosGroup/Vulkan-Headers.git "${headers}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    release_capture(head "${git}" -C "${headers}" rev-parse HEAD)
    if(NOT head STREQUAL revision)
        message(FATAL_ERROR "Expected Vulkan-Headers ${revision}; found ${head}")
    endif()
    if(platform STREQUAL "windows")
        set(archive "${DESTINATION}/glslang-16.6.0.zip")
        locked_download("https://github.com/KhronosGroup/glslang/releases/download/16.6.0/glslang-16.6.0-windows-x86_64-release.zip"
            "${archive}" 82bf434e69b9bb4829de7e2b4bc2c5e7a7861e53d66cf75e5cc70f5f694a8d9b)
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${DESTINATION}/glslang")
        set(glslang "${DESTINATION}/glslang/bin/glslang.exe")
    else()
        find_program(glslang NAMES glslangValidator glslang REQUIRED)
    endif()
    release_file("${glslang}")
    export_variable(MOSAICRAFT_VULKAN_INCLUDE "${headers}/include")
    export_variable(MOSAICRAFT_GLSLANG "${glslang}")
    message(STATUS "Vulkan headers: ${headers}/include; compiler: ${glslang}")
    return()
elseif(MODE STREQUAL "SmartCropVulkan")
    if(NOT platform MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "Vulkan smart crop SDKs target Windows and Linux x64")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/smart-crop-vulkan")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    file(MAKE_DIRECTORY "${DESTINATION}")
    file(READ "${repo}/cmake/smart-crop-vulkan.json" lock)
    string(JSON version GET "${lock}" version)
    string(JSON archive GET "${lock}" sdk "${platform}" archive)
    string(JSON hash GET "${lock}" sdk "${platform}" sha256)
    locked_download("https://github.com/Tencent/ncnn/releases/download/${version}/${archive}" "${DESTINATION}/${archive}" "${hash}")
    set(sdk "${DESTINATION}/sdk-${platform}")
    file(ARCHIVE_EXTRACT INPUT "${DESTINATION}/${archive}" DESTINATION "${sdk}")
    file(GLOB_RECURSE configs LIST_DIRECTORIES FALSE "${sdk}/*ncnnConfig.cmake")
    if(platform STREQUAL "windows")
        list(FILTER configs INCLUDE REGEX "/x64/")
    endif()
    list(LENGTH configs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one x64 ncnn SDK configuration, got: ${configs}")
    endif()
    get_filename_component(ncnn_config "${configs}" DIRECTORY)
    string(JSON revision GET "${lock}" revision)
    string(JSON hash GET "${lock}" licenseSha256)
    set(ncnn_license "${DESTINATION}/ncnn-LICENSE.txt")
    locked_download("https://raw.githubusercontent.com/Tencent/ncnn/${revision}/LICENSE.txt" "${ncnn_license}" "${hash}")
    export_variable(MOSAICRAFT_NCNN_DIR "${ncnn_config}")
    export_variable(MOSAICRAFT_NCNN_LICENSE "${ncnn_license}")
    if(PREPARE_VULKAN_MODELS)
        if(NOT platform STREQUAL "windows")
            message(FATAL_ERROR "Convert Vulkan models on Windows with the locked pnnx tool, then copy the checked files")
        endif()
        if(NOT DEFINED SMART_CROP_MODELS_DIR)
            set(SMART_CROP_MODELS_DIR "${repo}/build/smart-crop-models/prepared")
        endif()
        set(published_models "${SMART_CROP_MODELS_DIR}/vulkan")
        include("${CMAKE_CURRENT_LIST_DIR}/SmartCropRelease.cmake")
        if(NOT IS_DIRECTORY "${published_models}")
            string(JSON archive GET "${lock}" converter archive)
            string(JSON hash GET "${lock}" converter sha256)
            locked_download("https://github.com/pnnx/pnnx/releases/download/${version}/${archive}" "${DESTINATION}/${archive}" "${hash}")
            file(ARCHIVE_EXTRACT INPUT "${DESTINATION}/${archive}" DESTINATION "${DESTINATION}")
            find_program(python NAMES python python3 REQUIRED)
            string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
            set(conversion "${DESTINATION}/conversion-${nonce}")
            execute_process(COMMAND "${python}" "${repo}/scripts/prepare_smart_crop_vulkan.py"
                "${SMART_CROP_MODELS_DIR}" "${DESTINATION}" "${conversion}" COMMAND_ERROR_IS_FATAL ANY)
            set(staged "${conversion}/verified")
            file(MAKE_DIRECTORY "${staged}")
            foreach(model IN ITEMS saliency real anime)
                foreach(ext IN ITEMS param bin)
                    file(COPY_FILE "${conversion}/${model}/model.ncnn.${ext}" "${staged}/${model}.${ext}")
                endforeach()
            endforeach()
            smart_crop_verified_vulkan_models("${lock}" "${staged}" verified)
            file(RENAME "${staged}" "${published_models}")
        endif()
        smart_crop_verified_vulkan_models("${lock}" "${published_models}" verified)
    endif()
    return()
elseif(MODE STREQUAL "Qt")
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/qt-sdk")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    file(READ "${repo}/cmake/qt-sdk.json" lock)
    string(JSON version GET "${lock}" version)
    string(JSON repository GET "${lock}" repository)
    string(JSON archives GET "${lock}" platforms "${platform}-${arch}" archives)
    set(downloads "${DESTINATION}/.downloads")
    set(qt "${DESTINATION}/${version}")
    file(MAKE_DIRECTORY "${downloads}" "${qt}")
    string(JSON count LENGTH "${archives}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON entry GET "${archives}" ${index})
        string(JSON path GET "${entry}" path)
        string(JSON hash GET "${entry}" sha256)
        get_filename_component(name "${path}" NAME)
        locked_download("${repository}/${path}" "${downloads}/${name}" "${hash}")
        string(JSON subdir ERROR_VARIABLE missing GET "${entry}" destination)
        if(missing)
            set(subdir "")
        endif()
        # The ICU payload is flat and belongs next to libQt6Core on Linux.
        file(MAKE_DIRECTORY "${qt}/${subdir}")
        file(ARCHIVE_EXTRACT INPUT "${downloads}/${name}" DESTINATION "${qt}/${subdir}")
    endforeach()
    # Offline Installer payloads omit the installer-generated relocatable qt.conf.
    file(WRITE "${qt}/bin/qt.conf" "[Paths]\nPrefix=..\n")
    release_file("${qt}/lib/cmake/Qt6/Qt6Config.cmake")
    execute_process(COMMAND "${qt}/bin/lrelease${suffix}" -version COMMAND_ERROR_IS_FATAL ANY)
    export_variable(MOSAICRAFT_QT_ROOT "${qt}")
    message(STATUS "Qt ${version}: ${qt}")
    return()
elseif(NOT MODE MATCHES "^(Prepare|Install)$")
    message(FATAL_ERROR "MODE must be Prepare, Install, CUDA, CuDNN, Vulkan, Qt, Models, SmartCropGate, SmartCropVulkan or SmartCropCudaRedist")
endif()

