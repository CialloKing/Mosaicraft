    string(LENGTH "${baseline}" length)
    if(NOT length EQUAL 40 OR NOT baseline MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid vcpkg baseline in ${repo}/vcpkg.json")
    endif()
    if(MODE STREQUAL "Lock")
