    set(generator "Visual Studio 18 2026")
    set(host_triplet "${arch}-windows-release")
    if(DEFINED TARGET_ARCH)
        string(TOLOWER "${TARGET_ARCH}" arch)
        if(NOT arch MATCHES "^(x64|arm64)$")
            message(FATAL_ERROR "Windows TARGET_ARCH must be x64 or arm64")
        endif()
    endif()
    if(arch STREQUAL "arm64")
        list(APPEND probe_args -A ARM64)
    else()
        list(APPEND probe_args -A x64)
    endif()
else()
    if(DEFINED TARGET_ARCH)
        message(FATAL_ERROR "TARGET_ARCH is only used for Windows dependency preparation")
    endif()
    find_program(ninja ninja REQUIRED)
    if(platform STREQUAL "macos")
        set(os osx)
        set(parallel 2)
        list(APPEND probe_args -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0)
        export_variable(MACOSX_DEPLOYMENT_TARGET 13.0)
        foreach(name IN ITEMS CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH CPPFLAGS CFLAGS CXXFLAGS LDFLAGS)
            export_variable("${name}" "")
        endforeach()
