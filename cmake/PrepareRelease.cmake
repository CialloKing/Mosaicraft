function(export_variable name value)
    set(ENV{${name}} "${value}")
    if(NOT "$ENV{GITHUB_ENV}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_ENV}" "${name}=${value}\n")
    endif()
endfunction()

function(locked_download url path hash)
    string(TOLOWER "${hash}" hash)
    if(EXISTS "${path}")
        file(SHA256 "${path}" actual)
        if(actual STREQUAL hash)
            return()
        endif()
    endif()
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(temp "${path}.${nonce}.download")
    foreach(attempt RANGE 1 3)
        file(DOWNLOAD "${url}" "${temp}" TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 45 STATUS status)
        list(GET status 0 code)
        if(code EQUAL 0)
            file(SHA256 "${temp}" actual)
            if(NOT actual STREQUAL hash)
                message(FATAL_ERROR "Download failed SHA-256 validation: ${url}")
            endif()
            file(RENAME "${temp}" "${path}")
            return()
        endif()
        if(attempt LESS 3)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
        endif()
    endforeach()
    message(FATAL_ERROR "Could not download ${url}: ${status}")
endfunction()

if(MODE STREQUAL "CUDA")
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "CUDA preparation supports Windows and Linux x64 only")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/cuda-13.5")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    set(downloads "${repo}/build/cuda-downloads")
    file(MAKE_DIRECTORY "${DESTINATION}/licenses" "${downloads}")
    file(READ "${CMAKE_CURRENT_LIST_DIR}/cuda-13.5.json" lock)
    string(JSON length LENGTH "${lock}" components)
    math(EXPR last "${length} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON component MEMBER "${lock}" components ${index})
        string(JSON entry GET "${lock}" components "${component}" "${platform}-x86_64")
        string(JSON relative GET "${entry}" relative_path)
        string(JSON hash GET "${entry}" sha256)
        get_filename_component(name "${relative}" NAME)
        set(archive "${downloads}/${name}")
        locked_download("https://developer.download.nvidia.com/compute/cuda/redist/${relative}" "${archive}" "${hash}")
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
        set(extract "${downloads}/extract-${nonce}")
        file(MAKE_DIRECTORY "${extract}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
        file(GLOB roots "${extract}/*")
        list(LENGTH roots count)
        if(NOT count EQUAL 1 OR NOT IS_DIRECTORY "${roots}")
            message(FATAL_ERROR "Unexpected CUDA component archive layout: ${archive}")
        endif()
        if(EXISTS "${roots}/LICENSE.txt")
            file(COPY_FILE "${roots}/LICENSE.txt" "${DESTINATION}/licenses/${component}.txt")
        endif()
        file(COPY "${roots}/" DESTINATION "${DESTINATION}" USE_SOURCE_PERMISSIONS)
        file(REMOVE_RECURSE "${extract}")
    endforeach()
    string(JSON version GET "${lock}" components cuda_nvcc version)
    string(REPLACE "." "\\." pattern "${version}")
    release_capture(actual "${DESTINATION}/bin/nvcc${suffix}" --version)
    if(NOT actual MATCHES "V${pattern}([^0-9]|$)")
        message(FATAL_ERROR "Unexpected nvcc version: ${actual}")
    endif()
    export_variable(CUDA_PATH "${DESTINATION}")
    export_variable(CUDAToolkit_ROOT "${DESTINATION}")
    if(NOT "$ENV{GITHUB_PATH}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_PATH}" "${DESTINATION}/bin\n")
    endif()
    message(STATUS "CUDA ${version}: ${DESTINATION}")
    return()
elseif(MODE STREQUAL "Vulkan")
    if(platform STREQUAL "macos")
        message(FATAL_ERROR "Use Metal on macOS")
    endif()
    if(NOT DEFINED DESTINATION)
        set(DESTINATION "${repo}/build/tools/vulkan")
    endif()
    cmake_path(ABSOLUTE_PATH DESTINATION BASE_DIRECTORY "${repo}" NORMALIZE)
    set(headers "${DESTINATION}/Vulkan-Headers")
    set(revision b379292b2ab6df5771ba9870d53cf8b2c9295daf)
    file(MAKE_DIRECTORY "${DESTINATION}")
    if(NOT EXISTS "${headers}/.git")
        execute_process(COMMAND "${git}" clone --depth 1 --branch v1.3.290
            https://github.com/KhronosGroup/Vulkan-Headers.git "${headers}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    release_capture(head "${git}" -C "${headers}" rev-parse HEAD)
    if(NOT head STREQUAL revision)
        message(FATAL_ERROR "Expected Vulkan-Headers ${revision}; found ${head}")
    endif()
    if(platform STREQUAL "windows")
        set(archive "${DESTINATION}/glslang-16.6.0.zip")
        locked_download("https://github.com/KhronosGroup/glslang/releases/download/16.6.0/glslang-16.6.0-windows-x86_64-release.zip"
            "${archive}" 82bf434e69b9bb4829de7e2b4bc2c5e7a7861e53d66cf75e5cc70f5f694a8d9b)
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${DESTINATION}/glslang")
        set(glslang "${DESTINATION}/glslang/bin/glslang.exe")
    else()
        find_program(glslang NAMES glslangValidator glslang REQUIRED)
    endif()
    release_file("${glslang}")
    export_variable(MOSAICRAFT_VULKAN_INCLUDE "${headers}/include")
    export_variable(MOSAICRAFT_GLSLANG "${glslang}")
    message(STATUS "Vulkan headers: ${headers}/include; compiler: ${glslang}")
    return()
elseif(NOT MODE MATCHES "^(Prepare|Install)$")
    message(FATAL_ERROR "MODE must be Prepare, Install, CUDA or Vulkan")
endif()

if(NOT DEFINED VCPKG_ROOT)
    set(VCPKG_ROOT "$ENV{VCPKG_ROOT}")
endif()
release_file("${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
file(REAL_PATH "${VCPKG_ROOT}" VCPKG_ROOT)
file(READ "${repo}/vcpkg.json" manifest)
string(JSON baseline GET "${manifest}" builtin-baseline)
release_capture(head "${git}" -C "${VCPKG_ROOT}" rev-parse HEAD)
if(NOT head STREQUAL baseline)
    message(FATAL_ERROR "Expected pinned vcpkg checkout ${baseline}; found ${head}")
endif()
if(NOT DEFINED CACHE_NAMESPACE)
    set(CACHE_NAMESPACE deps-v1)
endif()
if(NOT CACHE_NAMESPACE MATCHES "^[a-zA-Z0-9_.-]+$")
    message(FATAL_ERROR "Invalid dependency cache namespace")
endif()
set(generator Ninja)
set(parallel 4)
set(os "${platform}")
set(probe_args)
if(platform STREQUAL "windows")
    set(generator "Visual Studio 18 2026")
    set(host_triplet "${arch}-windows-release")
    if(DEFINED TARGET_ARCH)
        string(TOLOWER "${TARGET_ARCH}" arch)
        if(NOT arch MATCHES "^(x64|arm64)$")
            message(FATAL_ERROR "Windows TARGET_ARCH must be x64 or arm64")
        endif()
    endif()
    if(arch STREQUAL "arm64")
        list(APPEND probe_args -A ARM64)
    else()
        list(APPEND probe_args -A x64)
    endif()
else()
    if(DEFINED TARGET_ARCH)
        message(FATAL_ERROR "TARGET_ARCH is only used for Windows dependency preparation")
    endif()
    find_program(ninja ninja REQUIRED)
    if(platform STREQUAL "macos")
        set(os osx)
        set(parallel 2)
        list(APPEND probe_args -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0)
        export_variable(MACOSX_DEPLOYMENT_TARGET 13.0)
        foreach(name IN ITEMS CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH LIBRARY_PATH CPPFLAGS CFLAGS CXXFLAGS LDFLAGS)
            export_variable("${name}" "")
        endforeach()
    endif()
endif()
set(triplet "${arch}-${os}-release")
if(NOT host_triplet)
    set(host_triplet "${triplet}")
endif()
set(work "${repo}/build/dependency-state/${triplet}")
set(installed "${repo}/third_party/vcpkg_installed")
set(buildtrees "${repo}/build/vcpkg-buildtrees")
set(packages "${repo}/build/vcpkg-packages")
if(platform STREQUAL "windows" AND arch STREQUAL "arm64")
    # Each Windows target has its own vcpkg manifest state.
    string(APPEND installed "/arm64")
    set(buildtrees "${work}/buildtrees")
    set(packages "${work}/packages")
endif()
if(NOT DEFINED DOWNLOADS_DIR)
    set(DOWNLOADS_DIR "${repo}/build/vcpkg-downloads")
endif()
cmake_path(ABSOLUTE_PATH DOWNLOADS_DIR BASE_DIRECTORY "${repo}" NORMALIZE OUTPUT_VARIABLE downloads)
set(cache "${repo}/build/dependency-cache")
if(NOT "$ENV{RUNNER_TEMP}" STREQUAL "")
    set(cache "$ENV{RUNNER_TEMP}/mosaicraft-vcpkg-cache")
endif()
file(TO_CMAKE_PATH "${cache}" cache)
set(trusted false)
if(NOT "$ENV{GITHUB_EVENT_NAME}" STREQUAL "pull_request" AND "$ENV{GITHUB_REF}" MATCHES "^refs/(heads/main$|tags/v)")
    set(trusted true)
endif()
set(access read)
if("$ENV{GITHUB_ACTIONS}" STREQUAL "" OR trusted)
    set(access readwrite)
endif()
file(MAKE_DIRECTORY "${work}" "${installed}" "${cache}" "${downloads}")
export_variable(VCPKG_ROOT "${VCPKG_ROOT}")
export_variable(VCPKG_OVERLAY_TRIPLETS "${repo}/cmake/triplets")
export_variable(VCPKG_DEFAULT_TRIPLET "${triplet}")
export_variable(VCPKG_DEFAULT_HOST_TRIPLET "${host_triplet}")
export_variable(VCPKG_BINARY_SOURCES "clear;files,${cache},${access}")
export_variable(VCPKG_DOWNLOADS "${downloads}")
export_variable(VCPKG_MAX_CONCURRENCY "${parallel}")
export_variable(MOSAICRAFT_VCPKG_INSTALLED_DIR "${installed}")
export_variable(CMAKE_BUILD_PARALLEL_LEVEL "${parallel}")
set(vcpkg "${VCPKG_ROOT}/vcpkg${suffix}")
if(MODE STREQUAL "Prepare")
    if(platform STREQUAL "windows")
        # Windows vcpkg bootstrap delegates to powershell.exe, so fetch the pinned binary directly.
        file(STRINGS "${VCPKG_ROOT}/scripts/vcpkg-tool-metadata.txt" tool_tag REGEX "^VCPKG_TOOL_RELEASE_TAG=")
        if(NOT tool_tag STREQUAL "VCPKG_TOOL_RELEASE_TAG=2026-05-27")
            message(FATAL_ERROR "Update the Windows vcpkg tool lock together with the registry baseline")
        endif()
        locked_download("https://github.com/microsoft/vcpkg-tool/releases/download/2026-05-27/vcpkg.exe" "${vcpkg}"
            da75e3312ff6881c89f6171363eedb92933b0f79456cd6ee636316edef860ff7)
    elseif(NOT EXISTS "${vcpkg}")
        execute_process(COMMAND sh "${VCPKG_ROOT}/bootstrap-vcpkg.sh" -disableMetrics COMMAND_ERROR_IS_FATAL ANY)
    endif()
    set(cmake "${CMAKE_COMMAND}")
    if(platform STREQUAL "windows" AND CMAKE_VERSION VERSION_LESS 4.2)
        release_capture(tool "${vcpkg}" fetch cmake)
        string(REGEX REPLACE ".*\n" "" cmake "${tool}")
        release_file("${cmake}")
        get_filename_component(dir "${cmake}" DIRECTORY)
        if(NOT "$ENV{GITHUB_PATH}" STREQUAL "")
            file(APPEND "$ENV{GITHUB_PATH}" "${dir}\n")
        endif()
    endif()
    set(probe "${work}/probe-native")
    file(MAKE_DIRECTORY "${probe}")
    file(WRITE "${probe}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(MosaicraftToolchainProbe LANGUAGES CXX)
file(WRITE "${CMAKE_BINARY_DIR}/compiler.txt" "${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_CXX_COMPILER}|${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}|${CMAKE_OSX_SYSROOT}")
]=])
    execute_process(COMMAND "${cmake}" -S "${probe}" -B "${probe}/build" -G "${generator}" ${probe_args}
        COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${probe}/build/compiler.txt" compiler)
    release_capture(cmake_version "${cmake}" --version)
    release_capture(vcpkg_version "${vcpkg}" version --disable-metrics)
    set(toolchain "${compiler}\n${cmake_version}\n${vcpkg_version}")
    if(platform STREQUAL "macos")
        release_capture(xcode xcodebuild -version)
        release_capture(sdk xcrun --show-sdk-version)
        string(APPEND toolchain "\n${xcode}\n${sdk}")
    endif()
    string(SHA256 fingerprint "${toolchain}")
    file(READ "${repo}/cmake/triplets/${triplet}.cmake" configuration)
    if(NOT host_triplet STREQUAL triplet)
        file(READ "${repo}/cmake/triplets/${host_triplet}.cmake" host_configuration)
        string(APPEND configuration "\n${host_triplet}\n${host_configuration}")
    endif()
    string(SHA256 config_hash "${manifest}\n${configuration}")
    set(prefix "${CACHE_NAMESPACE}-${platform}-${arch}-${fingerprint}-${baseline}-")
    set(key "${prefix}${config_hash}")
    file(WRITE "${work}/toolchain.txt" "${key}\n${toolchain}\n")
    if(NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_OUTPUT}" "cache-key=${key}\ncache-prefix=${prefix}\ncache-path=${cache}\ncache-write=${trusted}\n")
    endif()
    message(STATUS "Dependency cache key: ${key}; CMake: ${cmake}")
else()
    release_file("${vcpkg}")
    string(TIMESTAMP start "%s" UTC)
    file(WRITE "${work}/install.log" "")
    foreach(attempt RANGE 1 3)
        set(log "${work}/install-attempt-${attempt}.log")
        execute_process(COMMAND "${vcpkg}" install "--x-manifest-root=${repo}" "--triplet=${triplet}" "--host-triplet=${host_triplet}"
            "--x-install-root=${installed}" "--overlay-triplets=${repo}/cmake/triplets"
            "--x-buildtrees-root=${buildtrees}" "--x-packages-root=${packages}"
            --disable-metrics RESULT_VARIABLE status OUTPUT_FILE "${log}" ERROR_FILE "${log}")
        file(READ "${log}" output)
        file(APPEND "${work}/install.log" "${output}")
        message("${output}")
        if(status STREQUAL "0")
            break()
        elseif(attempt EQUAL 3 OR NOT output MATCHES "response code (429|50[0234])|timed out|Could not resolve host")
            message(FATAL_ERROR "Locked dependency installation failed (${status})")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 5)
    endforeach()
    file(READ "${work}/install.log" output)
    if(output MATCHES "Installing [0-9]+/[0-9]+ (protobuf|abseil|flatbuffers)|Building [^ ]+-dbg")
        message(FATAL_ERROR "Unexpected heavyweight or Debug dependency in the minimal Release configuration")
    endif()
    string(TIMESTAMP end "%s" UTC)
    math(EXPR seconds "${end} - ${start}")
    string(REGEX MATCH "Restored ([0-9]+) package" match "${output}")
    set(restored "${CMAKE_MATCH_1}")
    if(restored STREQUAL "")
        set(restored 0)
    endif()
    file(WRITE "${work}/install-summary.json" "{\"seconds\":${seconds},\"triplet\":\"${triplet}\",\"baseline\":\"${baseline}\",\"restoredPackages\":${restored}}\n")
    if(NOT "$ENV{GITHUB_STEP_SUMMARY}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "Dependencies ${triplet}: ${seconds} s; restored packages: ${restored}\n")
    endif()
endif()
